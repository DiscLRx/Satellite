<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <CoreCustomRoot>..\SatelliteCore\Custom</CoreCustomRoot>
    <UiCustomRoot>..\SatelliteUI\Custom</UiCustomRoot>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\SatelliteCore\appdata.json"
          Condition="Exists('..\SatelliteCore\appdata.json')"
          Link="appdata.json"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../SatelliteCore/SatelliteCore.csproj" />
  </ItemGroup>

  <Target Name="CopyCustomAfterBuild"
          AfterTargets="Build"
          Condition="'$(TargetDir)' != ''">
    <ItemGroup>
      <_CoreCustomFiles Include="$(CoreCustomRoot)\**\*"
                        Condition="Exists('$(CoreCustomRoot)')" />
      <_UiCustomFiles Include="$(UiCustomRoot)\**\*"
                      Condition="Exists('$(UiCustomRoot)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_CoreCustomFiles)"
          DestinationFiles="@(_CoreCustomFiles->'$(TargetDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_UiCustomFiles)"
          DestinationFiles="@(_UiCustomFiles->'$(TargetDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCustomAfterPublish"
          AfterTargets="Publish"
          Condition="'$(PublishDir)' != ''">
    <ItemGroup>
      <_CoreCustomFilesPublish Include="$(CoreCustomRoot)\**\*"
                               Condition="Exists('$(CoreCustomRoot)')" />
      <_UiCustomFilesPublish Include="$(UiCustomRoot)\**\*"
                             Condition="Exists('$(UiCustomRoot)')" />
    </ItemGroup>
    <Copy SourceFiles="@(_CoreCustomFilesPublish)"
          DestinationFiles="@(_CoreCustomFilesPublish->'$(PublishDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_UiCustomFilesPublish)"
          DestinationFiles="@(_UiCustomFilesPublish->'$(PublishDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
