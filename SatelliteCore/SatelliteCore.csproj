<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14</LangVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugSymbols>false</DebugSymbols>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup>
    <AppDataJsonPath>$(MSBuildProjectDirectory)\appdata.json</AppDataJsonPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Data/Data.csproj" />
    <ProjectReference Include="../Server/Server.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="appdata.template.json" LogicalName="SatelliteCore.appdata.template.json" />
  </ItemGroup>

  <Target Name="CopyAppDataAfterBuild"
          AfterTargets="Build"
      Condition="Exists('$(AppDataJsonPath)')">
    <Copy SourceFiles="$(AppDataJsonPath)"
          DestinationFiles="$(TargetDir)appdata.json"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCustomAfterBuild"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\Custom')">
    <ItemGroup>
      <_CustomFiles Include="$(MSBuildProjectDirectory)\Custom\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CustomFiles)"
          DestinationFiles="@(_CustomFiles->'$(TargetDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyAppDataAfterPublish"
          AfterTargets="Publish"
      Condition="Exists('$(AppDataJsonPath)') and '$(PublishDir)' != ''">
    <Copy SourceFiles="$(AppDataJsonPath)"
          DestinationFiles="$(PublishDir)appdata.json"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyCustomAfterPublish"
          AfterTargets="Publish"
          Condition="Exists('$(MSBuildProjectDirectory)\Custom') and '$(PublishDir)' != ''">
    <ItemGroup>
      <_CustomFilesPublish Include="$(MSBuildProjectDirectory)\Custom\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(_CustomFilesPublish)"
          DestinationFiles="@(_CustomFilesPublish->'$(PublishDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
