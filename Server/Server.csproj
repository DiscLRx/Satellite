<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Data\Data.csproj" />
    </ItemGroup>

    <ItemGroup>
      <AvaloniaXaml Remove="COntrollers\**" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="COntrollers\**" />
      <Compile Include="Controllers\AuthApiController.cs" />
      <Compile Include="Controllers\FileAccessApiController.cs" />
      <Compile Include="Controllers\ExtraFunctionApiController.cs" />
      <Compile Include="Controllers\PageBackgroundApiController.cs" />
    </ItemGroup>

    <ItemGroup>
      <EmbeddedResource Remove="COntrollers\**" />
    </ItemGroup>

    <ItemGroup>
      <Content Remove="COntrollers\**" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Remove="COntrollers\**" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="COntrollers\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.VisualStudio.Web.CodeGeneration.Design" Version="10.0.2" />
    </ItemGroup>

</Project>
