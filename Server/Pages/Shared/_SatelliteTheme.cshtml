<style>
    :root {
        --bg: #081018;
        --panel: rgba(10, 19, 27, 0.616);
        --panel-strong: rgba(12, 24, 34, 0.672);
        --surface: rgba(255, 255, 255, 0.028);
        --surface-strong: rgba(255, 255, 255, 0.056);
        --line: rgba(122, 167, 191, 0.154);
        --line-strong: rgba(122, 167, 191, 0.238);
        --text: #ecf6fb;
        --text-muted: #8dc1ce;
        --accent: #59c4cf;
        --accent-strong: #ff9f5a;
        --danger: #ff8d8d;
        --shadow: 0 0 48px rgba(0, 0, 0, 0.26);
        --glass-blur: 7.2px;
        --soft-blur: 3.2px;
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        margin: 0;
        min-height: 100%;
        background: var(--bg);
        color: var(--text);
    }

    body {
        font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
        padding: 18px;
        -webkit-text-size-adjust: 100%;
    }

    button,
    input,
    select,
    textarea {
        font: inherit;
    }

    a {
        color: inherit;
    }

    .theme-shell {
        width: min(1120px, 100%);
        margin: 0 auto;
    }

    .theme-card {
        border: 1px solid var(--line);
        border-radius: 22px;
        background: var(--panel);
        box-shadow: var(--shadow);
        backdrop-filter: blur(var(--glass-blur));
        -webkit-backdrop-filter: blur(var(--glass-blur));
    }

    .theme-card--strong {
        background: var(--panel-strong);
    }

    .theme-hero {
        padding: 22px 24px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 16px 24px;
        align-items: center;
    }

    .theme-hero__title {
        margin: 0;
        font-family: "Bahnschrift", "IBM Plex Sans", sans-serif;
        font-size: clamp(1.3rem, 2.4vw, 1.8rem);
        line-height: 1;
        letter-spacing: 0.03em;
        text-transform: uppercase;
    }

    .theme-hero__subtitle {
        margin: 10px 0 0;
        color: var(--text-muted);
        font-size: 0.95rem;
        line-height: 1.6;
    }

    .theme-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 16px;
        border-radius: 14px;
        border: 1px solid rgba(255, 138, 61, 0.34);
        background: rgba(255, 138, 61, 0.08);
        color: var(--text);
        text-decoration: none;
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.035);
        white-space: nowrap;
        transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
    }

    .theme-link:hover,
    .theme-link:focus-visible {
        border-color: rgba(255, 138, 61, 0.52);
        background: rgba(255, 138, 61, 0.14);
        transform: translateY(-1px);
        outline: none;
    }

    .theme-button {
        min-height: 44px;
        padding: 0 16px;
        border-radius: 14px;
        border: 1px solid rgba(89, 196, 207, 0.322);
        background: rgba(89, 196, 207, 0.126);
        color: var(--text);
        cursor: pointer;
        transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    .theme-button:hover,
    .theme-button:focus-visible {
        border-color: rgba(89, 196, 207, 0.532);
        background: rgba(89, 196, 207, 0.21);
        box-shadow: 0 12px 24px rgba(89, 196, 207, 0.098);
        outline: none;
    }

    .theme-button:active {
        transform: scale(0.99);
    }

    .theme-button--accent {
        border-color: rgba(255, 159, 90, 0.364);
        background: rgba(255, 159, 90, 0.126);
        color: #fff7ef;
    }

    .theme-button--accent:hover,
    .theme-button--accent:focus-visible {
        border-color: rgba(255, 159, 90, 0.574);
        background: rgba(255, 159, 90, 0.21);
        box-shadow: 0 12px 24px rgba(255, 159, 90, 0.112);
    }

    .theme-field {
        width: 100%;
        min-height: 44px;
        border-radius: 14px;
        border: 1px solid var(--line);
        background: rgba(255, 255, 255, 0.035);
        color: var(--text);
        padding: 0 14px;
        outline: none;
        transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    }

    textarea.theme-field {
        min-height: 160px;
        padding: 14px;
        resize: vertical;
    }

    .theme-field:hover {
        border-color: rgba(122, 167, 191, 0.308);
        background: rgba(255, 255, 255, 0.049);
    }

    .theme-field:focus,
    .theme-field:focus-visible {
        border-color: rgba(89, 196, 207, 0.546);
        box-shadow: 0 0 0 3px rgba(89, 196, 207, 0.112);
        background: rgba(255, 255, 255, 0.063);
    }

    .theme-panel {
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--surface);
    }

    .theme-muted {
        color: var(--text-muted);
    }

    @@media (max-width: 760px) {
        body {
            padding: 12px;
        }

        .theme-hero {
            grid-template-columns: 1fr;
            align-items: start;
        }
    }
</style>