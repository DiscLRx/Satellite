@page "/ex/manga/{locationBase64}/{pathBase64?}"
@model Server.Pages.MangaPage

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <meta name="format-detection" content="telephone=no,email=no,address=no"/>
    <title>Manga Player</title>
    <style>
        :root {
            --control-bar-height: 50px;
            --viewer-padding: 10px;
            --panel-bg: rgba(0, 0, 0, 0.78);
            --surface-bg: rgba(18, 18, 20, 0.58);
            --line: rgba(255, 255, 255, 0.16);
            --text-main: #f7f7f7;
            --text-sub: #d0d0d4;
            --btn-bg: rgba(39, 96, 168, 0.82);
            --btn-bg-hover: rgba(56, 120, 198, 0.9);
            --btn-line: rgba(101, 158, 232, 0.76);
            --input-bg: rgba(28, 28, 31, 0.84);
            --input-line: rgba(255, 255, 255, 0.2);
        }

        html,
        body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            height: 100vh;
            height: 100dvh;
            min-height: 100%;
            min-height: 100dvh;
            color: var(--text-main);
            overscroll-behavior-y: none;
            touch-action: manipulation;
        }

        html {
            background: #000;
        }

        body {
            background: transparent;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            -webkit-text-size-adjust: 100%;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
        }

        .viewer {
            flex: 1 1 auto;
            min-height: 0;
            padding: var(--viewer-padding);
            box-sizing: border-box;
            display: grid;
            place-items: center;
            overflow: hidden;
        }

        .image-stage {
            width: 100%;
            height: 100%;
            position: relative;
            border-radius: 14px;
            background: var(--surface-bg);
            border: 1px solid var(--line);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            overflow: hidden;
            display: block;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
        }

        .image-surface {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            object-fit: contain;
            user-select: none;
            cursor: pointer;
        }

        .empty {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: min(100%, 480px);
            color: var(--text-sub);
            font-size: 0.95rem;
            text-align: center;
            padding: 0 16px;
            box-sizing: border-box;
        }

        .bottom-bar {
            position: relative;
            width: 100%;
            flex: 0 0 auto;
            min-height: calc(var(--control-bar-height) + env(safe-area-inset-bottom));
            height: auto;
            padding: 6px 0 calc(6px + env(safe-area-inset-bottom));
            box-sizing: border-box;
            background: var(--panel-bg);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-top: 1px solid var(--line);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .controls {
            width: min(980px, 100%);
            padding: 0 8px;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-wrap: nowrap;
            gap: 6px;
            overflow-x: auto;
            overflow-y: hidden;
            -webkit-overflow-scrolling: touch;
        }

        .controls > * {
            flex: 1 0 0;
            min-width: 34px;
            max-width: 120px;
        }

        .btn,
        .interval,
        .jump-input {
            height: 36px;
            border-radius: 10px;
            font-size: 0.9rem;
            box-sizing: border-box;
        }

        .btn {
            width: 100%;
            padding: 0 12px;
            border: 1px solid var(--btn-line);
            background: var(--btn-bg);
            color: #f5f9ff;
            cursor: pointer;
            transition: background 0.18s ease, border-color 0.18s ease;
        }

        .btn:hover,
        .btn:focus-visible {
            background: var(--btn-bg-hover);
            border-color: rgba(150, 198, 255, 0.95);
            outline: none;
        }

        #togglePlay,
        .jump-btn,
        #prevBtn,
        #nextBtn {
            min-width: 30px;
        }

        .interval,
        .jump-input {
            border: 1px solid var(--input-line);
            background: var(--input-bg);
            color: #eef1f5;
            text-align: center;
            padding: 0 8px;
        }

        .interval-wrap {
            position: relative;
            width: 100%;
            min-width: 56px;
            max-width: 88px;
        }

        .interval {
            width: 100%;
            padding-right: 20px;
        }

        .interval-unit {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            color: #b8c0cb;
            font-size: 0.8rem;
            pointer-events: none;
            user-select: none;
        }

        .interval:focus,
        .jump-input:focus {
            outline: 1px solid rgba(210, 226, 255, 0.72);
            border-color: rgba(210, 226, 255, 0.72);
        }

        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type="number"] {
            -moz-appearance: textfield;
            appearance: textfield;
        }

        .status {
            color: var(--text-sub);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-width: 72px;
            font-size: 0.82rem;
            width: 100%;
        }

        .status-label {
            white-space: nowrap;
        }

        .jump-input {
            width: 100%;
            min-width: 44px;
            max-width: 64px;
            font-size: 0.82rem;
        }

        @@media (max-width: 900px) {
            .controls {
                justify-content: center;
            }

            .status {
                font-size: 0.78rem;
            }
        }

        @@media (min-width: 901px) {
            .controls {
                overflow-x: visible;
            }
        }
    </style>

</head>
<body>
<main class="viewer">
    <section class="image-stage" aria-label="图片展示区">
        @if (Model.ImageUrlList.Count == 0)
        {
            <div class="empty">未找到可播放的图片（支持 jpg/jpeg/png/webp/gif/bmp/avif）</div>
        }
        else
        {
            <img id="viewerImage" class="image-surface" alt="manga image" decoding="sync"/>
        }
    </section>
</main>

<footer class="bottom-bar">
    <div class="controls">
        <button id="togglePlay" class="btn" type="button">Play</button>
        <div class="interval-wrap">
            <input id="intervalInput" class="interval" type="number" min="0.5" step="0.5" value="3" aria-label="播放间隔（秒）"/>
            <span class="interval-unit">s</span>
        </div>
        <div id="statusText" class="status">
            <input id="jumpInput" class="jump-input" type="number" min="1" step="1" value="1" aria-label="跳转到第几张"/>
            <span id="totalCountLabel" class="status-label">/ 0</span>
        </div>
        <button id="jumpBtn" class="btn jump-btn" type="button">Go</button>
        <button id="prevBtn" class="btn" type="button">←</button>
        <button id="nextBtn" class="btn" type="button">→</button>
    </div>
</footer>

<script>
    const imageList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ImageUrlList));
    const viewerImage = document.getElementById("viewerImage");
    const togglePlay = document.getElementById("togglePlay");
    const intervalInput = document.getElementById("intervalInput");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const jumpInput = document.getElementById("jumpInput");
    const jumpBtn = document.getElementById("jumpBtn");
    const totalCountLabel = document.getElementById("totalCountLabel");

    const MAX_DECODE_QUEUE = 3;
    let currentIndex = 0;
    let isPlaying = false;
    let timerId = null;
    let renderToken = 0;
    let currentEntry = null;
    let decodeQueue = [];
    let decodeCursor = 0;
    let isQueueLoading = false;

    function updateStatus() {
        if (!jumpInput || !totalCountLabel) return;
        if (imageList.length === 0) {
            jumpInput.value = "0";
            totalCountLabel.textContent = "/ 0";
            return;
        }
        totalCountLabel.textContent = `/ ${imageList.length}`;
        if (document.activeElement !== jumpInput) {
            jumpInput.value = `${currentIndex + 1}`;
        }
    }

    function revokeEntry(entry) {
        if (entry?.isObjectUrl && entry.url) {
            URL.revokeObjectURL(entry.url);
        }
    }

    async function waitForImageDecode(url) {
        return new Promise((resolve) => {
            const image = new Image();
            const done = () => resolve();
            image.decoding = "sync";
            image.onload = done;
            image.onerror = done;
            image.src = url;
            if (typeof image.decode === "function") {
                image.decode().then(done).catch(done);
                return;
            }
            if (image.complete) {
                resolve();
            }
        });
    }

    async function loadDecodedEntry(index) {
        const response = await fetch(imageList[index], { method: "GET" });
        if (!response.ok) {
            throw new Error(`Image load failed: ${response.status}`);
        }
        const blob = await response.blob();
        const objectUrl = URL.createObjectURL(blob);
        await waitForImageDecode(objectUrl);
        return {
            index,
            url: objectUrl,
            isObjectUrl: true,
        };
    }

    async function loadDisplayEntry(index) {
        try {
            return await loadDecodedEntry(index);
        } catch {
            const fallbackUrl = imageList[index];
            await waitForImageDecode(fallbackUrl);
            return {
                index,
                url: fallbackUrl,
                isObjectUrl: false,
            };
        }
    }

    function applyViewerEntry(entry) {
        if (!viewerImage) {
            revokeEntry(entry);
            return;
        }
        const previousEntry = currentEntry;
        currentEntry = entry;
        viewerImage.src = entry.url;
        if (previousEntry && previousEntry !== entry) {
            revokeEntry(previousEntry);
        }
        updateStatus();
    }

    function clearDecodeQueue() {
        for (const item of decodeQueue) {
            revokeEntry(item);
        }
        decodeQueue = [];
    }

    async function fillDecodeQueue() {
        if (isQueueLoading || imageList.length <= 1) return;
        isQueueLoading = true;
        try {
            const targetSize = Math.min(MAX_DECODE_QUEUE, imageList.length - 1);
            let attempts = 0;
            while (decodeQueue.length < targetSize && attempts < imageList.length * 2) {
                const indexToLoad = decodeCursor;
                decodeCursor = (decodeCursor + 1) % imageList.length;
                attempts += 1;

                if (indexToLoad === currentIndex || decodeQueue.some((item) => item.index === indexToLoad)) {
                    continue;
                }

                try {
                    const entry = await loadDisplayEntry(indexToLoad);
                    if (entry.index === currentIndex || decodeQueue.some((item) => item.index === entry.index)) {
                        revokeEntry(entry);
                        continue;
                    }
                    decodeQueue.push(entry);
                } catch {
                    // Ignore failed preload and continue trying next image.
                }
            }
        } finally {
            isQueueLoading = false;
        }
    }

    function resetDecodeQueue() {
        if (imageList.length <= 1) return;
        clearDecodeQueue();
        decodeCursor = (currentIndex + 1) % imageList.length;
        void fillDecodeQueue();
    }

    async function displayIndex(targetIndex) {
        const token = ++renderToken;
        const queuedIndex = decodeQueue.findIndex((item) => item.index === targetIndex);
        if (queuedIndex !== -1) {
            const entry = decodeQueue.splice(queuedIndex, 1)[0];
            if (token !== renderToken) {
                revokeEntry(entry);
                return;
            }
            currentIndex = targetIndex;
            applyViewerEntry(entry);
            resetDecodeQueue();
            return;
        }

        const entry = await loadDisplayEntry(targetIndex);
        if (token !== renderToken) {
            revokeEntry(entry);
            return;
        }
        currentIndex = targetIndex;
        applyViewerEntry(entry);
        resetDecodeQueue();
    }

    async function renderCurrentImage() {
        if (!viewerImage || imageList.length === 0) return;
        await displayIndex(currentIndex);
    }

    function stopPlay() {
        if (timerId !== null) {
            clearInterval(timerId);
            timerId = null;
        }
        isPlaying = false;
        if (togglePlay) togglePlay.textContent = "Play";
    }

    function getIntervalMs() {
        const value = Number(intervalInput?.value ?? "3");
        const safe = Number.isFinite(value) && value > 0 ? value : 3;
        return Math.max(500, Math.round(safe * 1000));
    }

    async function nextImage() {
        if (imageList.length === 0) return;
        const targetIndex = (currentIndex + 1) % imageList.length;
        await displayIndex(targetIndex);
    }

    async function prevImage() {
        if (imageList.length === 0) return;
        const targetIndex = (currentIndex - 1 + imageList.length) % imageList.length;
        await displayIndex(targetIndex);
    }

    function startPlay() {
        if (imageList.length <= 1) return;
        stopPlay();
        timerId = setInterval(nextImage, getIntervalMs());
        isPlaying = true;
        if (togglePlay) togglePlay.textContent = "Stop";
    }

    function jumpToImage() {
        if (imageList.length === 0 || !jumpInput) return;
        const raw = Number(jumpInput.value);
        if (!Number.isFinite(raw)) return;
        const target = Math.min(imageList.length, Math.max(1, Math.round(raw)));
        void displayIndex(target - 1);
    }

    togglePlay?.addEventListener("click", () => {
        if (isPlaying) {
            stopPlay();
        } else {
            startPlay();
        }
    });

    prevBtn?.addEventListener("click", () => {
        void prevImage();
    });

    nextBtn?.addEventListener("click", () => {
        void nextImage();
    });

    jumpBtn?.addEventListener("click", () => {
        jumpToImage();
    });

    viewerImage?.addEventListener("click", (event) => {
        const rect = viewerImage.getBoundingClientRect();
        const clickX = event.clientX - rect.left;
        if (clickX < rect.width / 2) {
            void prevImage();
        } else {
            void nextImage();
        }
    });

    jumpInput?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
            event.preventDefault();
            jumpToImage();
        }
    });

    intervalInput?.addEventListener("change", () => {
        if (isPlaying) {
            startPlay();
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
            void prevImage();
        } else if (event.key === "ArrowRight") {
            void nextImage();
        } else if (event.code === "Space") {
            event.preventDefault();
            if (isPlaying) {
                stopPlay();
            } else {
                startPlay();
            }
        }
    });

    updateStatus();
    void renderCurrentImage();
    if (jumpInput) {
        jumpInput.max = `${imageList.length}`;
    }
    if (imageList.length <= 1) {
        togglePlay?.setAttribute("disabled", "disabled");
    }
    if (imageList.length === 0) {
        jumpInput?.setAttribute("disabled", "disabled");
        jumpBtn?.setAttribute("disabled", "disabled");
    }
</script>
</body>
</html>