@page "/"
@model Server.Pages.LocationPage

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no,email=no,address=no" />
    <title>Location Page</title>
    <style>
            /* 版本 A：iOS 深色风格 */
            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                min-height: 100%;
                min-height: 100vh;
                color: #f7f7f7;
            }

            html {
                background: #000000;
            }

            html::before {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: var(--html-bg-image, none);
                background-position: center center;
                background-size: var(--html-bg-size, cover);
                background-repeat: no-repeat;
                background-attachment: fixed;
                filter: var(--html-bg-filter, none);
                transform: scale(1.04);
                z-index: -1;
                pointer-events: none;
            }

            html::after {
                content: '';
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background-image: var(--front-bg-image, none);
                background-position: center center;
                background-size: var(--front-bg-size, contain);
                background-repeat: no-repeat;
                pointer-events: none;
                z-index: -1;
            }

            body {
                background: transparent;
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
                padding-bottom: env(safe-area-inset-bottom);
                padding-bottom: constant(safe-area-inset-bottom);
                -webkit-text-size-adjust: 100%;
                overflow-y: auto;
            }

            a,
            a:visited,
            a:hover,
            a:active {
                color: inherit;
                text-decoration: none;
            }

            .page-wrap {
                padding: 16px;
                max-width: 760px;
                margin: 0 auto;
            }

            .header-bar {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                background: rgba(0, 0, 0, 0.75);
                backdrop-filter: blur(12px);
                -webkit-backdrop-filter: blur(12px);
                z-index: 100;
                padding: 16px;
                border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            }

            .header-bar h1 {
                margin: 0;
                font-size: 1.8rem;
                font-weight: 700;
                color: #ffffff;
            }

            .header-bar .byline {
                font-size: 0.95rem;
                color: #808081;
                font-weight: 600;
                margin-left: 8px;
            }

            .header-bar .byline-link {
                color: #808081;
                text-decoration: none;
            }

            .header-bar .byline-link:hover,
            .header-bar .byline-link:focus-visible {
                color: #ffffff;
            }

            .content-wrap {
                padding-top: 140px;
                padding-bottom: 60px;
            }

            .location-list {
                list-style: none;
                padding: 0;
                margin: 0;
            }

            .location-item {
                position: relative;
                cursor: pointer;
                background: rgba(48, 48, 48, 0.55);
                border: 1px solid rgba(255, 255, 255, 0.12);
                border-radius: 16px;
                backdrop-filter: blur(6px);
                -webkit-backdrop-filter: blur(6px);
                margin-bottom: 16px;
                padding: 18px 14px;
                color: #fff;
                box-shadow: 0 6px 14px rgba(0, 0, 0, 0.3);
                transition: transform 0.18s ease, box-shadow 0.18s ease, background 0.2s ease;
            }

            .location-item:active {
                transform: scale(0.99);
            }

            .location-item:hover {
                background: rgba(74, 74, 74, 0.85);
                transform: translateY(-1px);
                box-shadow: 0 10px 20px rgba(0, 0, 0, 0.38);
            }

            .location-item .name {
                font-size: 1.05rem;
                font-weight: 600;
                color: #fff;
            }
    </style>
</head>

<body>
    <div class="header-bar">
        <h1>Satellite<span class="byline">by <a class="byline-link" href="https://github.com/DiscLRx" target="_blank"
                                                    rel="noopener noreferrer">DiscLR</a></span></h1>
        </div>
        <div class="content-wrap">
            <div class="page-wrap">
                <ul id="locationList" class="location-list">
                    @foreach (var location in Model.Locations)
                    {
                        <a href="/b/@Server.Tools.Encoding.Base64.ToBase64Url(location.Name)">
                            <li class="location-item">
                                <div class="name">@location.Name</div>
                            </li>
                        </a>
                    }
                </ul>
            </div>
        </div>
        <script>
                const headerBar = document.querySelector('.header-bar');
                const contentWrap = document.querySelector('.content-wrap');

                function syncHeaderHeight() {
                    if (!headerBar || !contentWrap) {
                        return;
                    }
                    contentWrap.style.paddingTop = `${headerBar.offsetHeight}px`;
                }

                syncHeaderHeight();
                window.addEventListener('resize', syncHeaderHeight);

        </script>
        <script>
                @* 背景图片加载与设置 *@

                    async function loadBackgroundImage(windowWhRate) {
                        let imageType;
                        if (windowWhRate > 1) {
                            imageType = "horizontal";
                        } else {
                            imageType = "vertical";
                        }
                        let url = `/api/bg?imageType=${imageType}`;
                        const res = await fetch(url, { method: "GET" });
                        if (!res.ok) {
                            return null;
                        }
                        const blob = await res.blob();
                        return URL.createObjectURL(blob);
                    }

                let windowWhRate = window.innerWidth / window.innerHeight;
                let bgUrl = null;

                async function setBackground() {
                    let windowWhRateOld = windowWhRate;
                    windowWhRate = window.innerWidth / window.innerHeight;
                    if (bgUrl === null || (windowWhRateOld > 1 && windowWhRate <= 1) || (windowWhRateOld <= 1 && windowWhRate > 1)) {
                        bgUrl = await loadBackgroundImage(windowWhRate);
                    }

                    const htmlElement = document.documentElement;
                    if (bgUrl === null) {
                        htmlElement.style.setProperty("--html-bg-image", "none");
                        htmlElement.style.setProperty("--front-bg-image", "none");
                        return;
                    }

                    const img = new Image();
                    img.src = bgUrl;
                    await img.decode();
                    let imgWhRate = img.width / img.height;

                    htmlElement.style.setProperty("--html-bg-image", `url("${bgUrl}")`);
                    htmlElement.style.setProperty("--html-bg-size", "cover");
                    if ((windowWhRate > imgWhRate && windowWhRate > 1.7) || (windowWhRate < imgWhRate && windowWhRate < 0.3)) {
                        htmlElement.style.setProperty("--html-bg-filter", "blur(12px) brightness(0.45)");
                        htmlElement.style.setProperty("--front-bg-image", `url("${bgUrl}")`);
                        htmlElement.style.setProperty("--front-bg-size", "contain");
                    } else {
                        htmlElement.style.setProperty("--html-bg-filter", "none");
                        htmlElement.style.setProperty("--front-bg-image", "none");
                        htmlElement.style.setProperty("--front-bg-size", "cover");
                    }
                }

                window.addEventListener("resize", setBackground);
                setBackground();
        </script>
    </body>

</html>