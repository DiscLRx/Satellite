@page "/"
@model Server.Pages.LocationPage

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="format-detection" content="telephone=no,email=no,address=no" />
    <title>Location Page</title>
    @await Html.PartialAsync("/Pages/Shared/_SatelliteTheme.cshtml")
    <style>
        html,
        body {
            margin: 0;
            width: 100%;
            min-height: 100%;
        }

        html::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: var(--html-bg-image, none);
            background-position: center center;
            background-size: var(--html-bg-size, cover);
            background-repeat: no-repeat;
            background-attachment: fixed;
            filter: var(--html-bg-filter, none);
            transform: scale(1.04);
            z-index: -1;
            pointer-events: none;
        }

        html::after {
            content: "";
            position: fixed;
            inset: 0;
            background-image: var(--front-bg-image, none);
            background-position: center center;
            background-size: var(--front-bg-size, contain);
            background-repeat: no-repeat;
            pointer-events: none;
            z-index: -1;
        }

        body {
            background: transparent;
            background-color: rgba(6, 10, 16, 0);
            min-height: 100vh;
            padding: 0;
            padding-bottom: max(18px, env(safe-area-inset-bottom));
            overflow-y: auto;
            transition: background-color 0.22s ease;
        }

        body.is-light-off {
            background-color: rgba(6, 10, 16, 0.84);
        }

        .header-bar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: var(--panel-strong);
            backdrop-filter: blur(var(--glass-blur));
            -webkit-backdrop-filter: blur(var(--glass-blur));
            z-index: 100;
            padding: 18px 24px;
            border-bottom: 1px solid var(--line);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .header-actions {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .theme-light-toggle {
            min-width: 44px;
            width: 44px;
            padding: 0;
        }

        .theme-light-toggle .icon-light-on,
        .theme-light-toggle .icon-light-off {
            display: none;
            width: 20px;
            height: 20px;
        }

        .theme-light-toggle[data-light="off"] .icon-light-off,
        .theme-light-toggle[data-light="on"] .icon-light-on {
            display: block;
        }

        .header-bar__title {
            margin: 0;
            font-family: "Bahnschrift", "IBM Plex Sans", sans-serif;
            font-size: clamp(1.3rem, 2.4vw, 1.8rem);
            line-height: 1;
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .header-bar__byline {
            font-size: 0.9rem;
            color: var(--text-muted);
            font-weight: 500;
            margin-left: 10px;
            text-transform: none;
            letter-spacing: 0;
        }

        .header-bar__byline-link {
            color: var(--text-muted);
            text-decoration: none;
            transition: color 0.18s ease;
        }

        .header-bar__byline-link:hover,
        .header-bar__byline-link:focus-visible {
            color: var(--text);
            outline: none;
        }

        .content-wrap {
            padding-top: 100px;
            padding-bottom: 60px;
            padding-left: max(14px, env(safe-area-inset-left));
            padding-right: max(14px, env(safe-area-inset-right));
        }

        .location-list {
            list-style: none;
            padding: 0;
            margin: 0;
            display: grid;
            gap: 12px;
        }

        .location-link {
            display: block;
            padding: 18px 22px;
            text-decoration: none;
            transition: transform 0.18s ease, border-color 0.18s ease, background 0.18s ease;
        }

        .location-link:hover,
        .location-link:focus-visible {
            transform: translateY(-1px);
            border-color: rgba(255, 159, 90, 0.32);
            background: var(--panel-strong);
            outline: none;
        }

        .location-name {
            font-size: 1.05rem;
            font-weight: 600;
        }

        @@media (min-width: 761px) {
            .content-wrap {
                padding-left: 24px;
                padding-right: 24px;
            }

            .location-link {
                padding: 26px 26px;
            }
        }
    </style>
</head>

<body class="is-light-off">
    <div class="header-bar">
        <h1 class="header-bar__title">
            Satellite<span class="header-bar__byline">by <a class="header-bar__byline-link" href="https://github.com/DiscLRx" target="_blank" rel="noopener noreferrer">DiscLR</a></span>
        </h1>
        <div class="header-actions">
            <button id="lightToggleBtn" class="theme-link theme-light-toggle" type="button" data-light="on" aria-label="关灯" title="关灯" aria-pressed="false">
                <img class="icon-light-on" src="/api/res/icon/btn-light-on.svg" alt="开灯" aria-hidden="true" />
                <img class="icon-light-off" src="/api/res/icon/btn-light-off.svg" alt="关灯" aria-hidden="true" />
            </button>
        </div>
    </div>
    <div class="content-wrap">
        <div class="theme-shell">
            <ul id="locationList" class="location-list">
                @foreach (var location in Model.Locations)
                {
                    <li>
                        <a class="theme-card location-link" href="/b/@Server.Tools.Encoding.Base64.ToBase64Url(location.Name)">
                            <span class="location-name">@location.Name</span>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
    <script>
        const headerBar = document.querySelector('.header-bar');
        const contentWrap = document.querySelector('.content-wrap');
        const lightToggleBtn = document.getElementById("lightToggleBtn");
        const lightModeStorageKey = "lightMode";
        const legacyLightModeStorageKey = "liteplay.lightMode";

        function readLightMode() {
            try {
                const currentValue = (window.localStorage.getItem(lightModeStorageKey) || "").toLowerCase();
                if (currentValue === "on" || currentValue === "off") {
                    return currentValue;
                }

                const legacyValue = (window.localStorage.getItem(legacyLightModeStorageKey) || "").toLowerCase();
                if (legacyValue === "on" || legacyValue === "off") {
                    // Migrate old key so all pages share one canonical value.
                    window.localStorage.setItem(lightModeStorageKey, legacyValue);
                    return legacyValue;
                }

                return "";
            } catch {
                return "";
            }
        }

        function writeLightMode(mode) {
            try {
                window.localStorage.setItem(lightModeStorageKey, mode);
            } catch {
            }
        }

        function restoreLightModeFromStorage() {
            const storedMode = readLightMode();
            if (storedMode === "off") {
                document.body.classList.add("is-light-off");
                return;
            }

            if (storedMode === "on") {
                document.body.classList.remove("is-light-off");
            }
        }

        function syncLightToggleUi() {
            if (!lightToggleBtn) {
                return;
            }

            const isLightOff = document.body.classList.contains("is-light-off");
            lightToggleBtn.dataset.light = isLightOff ? "off" : "on";
            lightToggleBtn.setAttribute("aria-label", isLightOff ? "关灯" : "开灯");
            lightToggleBtn.setAttribute("title", isLightOff ? "关灯" : "开灯");
            lightToggleBtn.setAttribute("aria-pressed", isLightOff ? "true" : "false");
        }

        function toggleLightMask() {
            document.body.classList.toggle("is-light-off");
            const lightMode = document.body.classList.contains("is-light-off") ? "off" : "on";
            writeLightMode(lightMode);
            syncLightToggleUi();
        }

        function syncHeaderHeight() {
            if (!headerBar || !contentWrap) {
                return;
            }
            contentWrap.style.paddingTop = `${headerBar.offsetHeight + 32}px`;
        }

        syncHeaderHeight();
        window.addEventListener('resize', syncHeaderHeight);
        lightToggleBtn?.addEventListener("click", toggleLightMask);
        restoreLightModeFromStorage();
        syncLightToggleUi();

        @* 背景图片加载与设置 *@

        async function loadBackgroundImage(windowWhRate) {
            let imageType;
            if (windowWhRate > 1) {
                imageType = "horizontal";
            } else {
                imageType = "vertical";
            }
            let url = `/api/bg?imageType=${imageType}`;
            const res = await fetch(url, { method: "GET" });
            if (!res.ok) {
                return null;
            }
            const blob = await res.blob();
            return URL.createObjectURL(blob);
        }

        let windowWhRate = window.innerWidth / window.innerHeight;
        let bgUrl = null;

        async function setBackground() {
            let windowWhRateOld = windowWhRate;
            windowWhRate = window.innerWidth / window.innerHeight;
            if (bgUrl === null || (windowWhRateOld > 1 && windowWhRate <= 1) || (windowWhRateOld <= 1 && windowWhRate > 1)) {
                bgUrl = await loadBackgroundImage(windowWhRate);
            }

            const htmlElement = document.documentElement;
            if (bgUrl === null) {
                htmlElement.style.setProperty("--html-bg-image", "none");
                htmlElement.style.setProperty("--front-bg-image", "none");
                return;
            }

            const img = new Image();
            img.src = bgUrl;
            await img.decode();
            let imgWhRate = img.width / img.height;

            htmlElement.style.setProperty("--html-bg-image", `url("${bgUrl}")`);
            htmlElement.style.setProperty("--html-bg-size", "cover");
            if ((windowWhRate > imgWhRate && windowWhRate > 1.7) || (windowWhRate < imgWhRate && windowWhRate < 0.3)) {
                htmlElement.style.setProperty("--html-bg-filter", "blur(4.8px) brightness(0.45)");
                htmlElement.style.setProperty("--front-bg-image", `url("${bgUrl}")`);
                htmlElement.style.setProperty("--front-bg-size", "contain");
            } else {
                htmlElement.style.setProperty("--html-bg-filter", "none");
                htmlElement.style.setProperty("--front-bg-image", "none");
                htmlElement.style.setProperty("--front-bg-size", "cover");
            }
        }

        window.addEventListener("resize", setBackground);
        setBackground();
    </script>
    </body>

</html>