@page "/auth"
@using Server.Pages
@model Server.Pages.AuthPage

@{
}

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Login Page</title>
    @await Html.PartialAsync("/Pages/Shared/_SatelliteTheme.cshtml")
    <style>
        body {
            display: grid;
            place-items: center;
            min-height: 100dvh;
            overflow: hidden;
            overscroll-behavior-y: none;
            touch-action: manipulation;
            padding: max(18px, env(safe-area-inset-top)) 18px max(18px, env(safe-area-inset-bottom));
        }

        .login-shell {
            width: min(100%, 460px);
            position: relative;
        }

        .login-panel {
            padding: 22px;
            display: grid;
            gap: 14px;
        }

        .login-header {
            display: grid;
            gap: 10px;
        }

        .login-kicker {
            color: var(--accent);
            font-size: 0.78rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .login-title {
            margin: 0;
            font-family: "Bahnschrift", "IBM Plex Sans", sans-serif;
            font-size: clamp(1.36rem, 2vw, 1.8rem);
            letter-spacing: 0.03em;
            text-transform: uppercase;
        }

        .login-subtitle {
            margin: 0;
            color: var(--text-muted);
            line-height: 1.6;
        }

        .password-input {
            height: 52px;
            font-size: 1rem;
        }

        .password-input::placeholder {
            color: rgba(157, 177, 190, 0.84);
        }

        .confirm-button {
            width: 100%;
            min-height: 50px;
            font-size: 0.98rem;
            font-weight: 600;
        }

        .toast {
            position: absolute;
            left: 0;
            right: 0;
            bottom: calc(100% + 0.75rem);
            transform: translateY(12px);
            box-sizing: border-box;
            padding: 12px 14px;
            border-radius: 16px;
            border: 1px solid rgba(255, 141, 141, 0.224);
            background: rgba(71, 25, 25, 0.616);
            color: #ffe5e5;
            backdrop-filter: blur(6.4px);
            -webkit-backdrop-filter: blur(6.4px);
            box-shadow: var(--shadow);
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
            z-index: 20;
        }

        .toast.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
            transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
        }

        @@media (max-width: 760px) {
            .login-panel {
                padding: 18px;
            }

            .password-input,
            .confirm-button {
                font-size: 16px;
            }
        }
    </style>
</head>

<body>
    <main class="login-shell">
        <div id="errorToast" class="toast" role="status" aria-live="polite"></div>
        <section class="login-panel theme-card theme-card--strong">
            <header class="login-header">
                <div class="login-kicker">Satellite</div>
                <h1 class="login-title">身份验证</h1>
            </header>
            <input id="keyInput" class="password-input theme-field" type="password" placeholder="Key" />
            <button class="confirm-button theme-button theme-button--accent" type="button" id="ok">Ok</button>
        </section>
    </main>

    <script>
            const keyInput = document.querySelector("#keyInput");
            const errorToast = document.querySelector("#errorToast");
            let toastTimerId = null;

            function showToast(message) {
                errorToast.textContent = message;
                errorToast.classList.add("show");
                if (toastTimerId) {
                    clearTimeout(toastTimerId);
                }
                toastTimerId = setTimeout(() => {
                    errorToast.classList.remove("show");
                }, 2200);
            }

            async function TestPassword(password) {
                return await fetch(
                    `/api/a/key`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=utf-8",
                        },
                        body: new URLSearchParams({ key: password }).toString()
                    }
                ).then(res => {
                    if(res.ok) {
                        return res.text();
                    } else {
                        throw new Error("网络错误，请稍后再试");
                    }
                })
            }

            document.querySelector("#ok").addEventListener('click',async () => {
                const key = keyInput.value;
                if (!key) {
                    showToast("请输入密码");
                    keyInput.focus();
                    return;
                }

                const result = await TestPassword(key).catch(err => {
                    showToast(err.message);
                });
                if (result == "1") {

                    document.cookie = `Auth-Key=${key}; expires=Fri, 31 Dec 9999 23:59:59 GMT; path=/`;
                    window.location.href = "@Model.OriginalPath";
                } else if(result == "0") {
                    keyInput.value = "";
                    showToast("密码错误，请重试");
                    keyInput.focus();
                }
            })

            keyInput.addEventListener('keypress', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    document.querySelector("#ok").click();
                }
            });
    </script>
</body>

</html>