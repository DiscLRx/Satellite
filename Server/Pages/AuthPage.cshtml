@page "/auth"
@using Server.Pages
@model Server.Pages.AuthPage

@{
}

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Login Page</title>
    <style>
            html,
            body {
                margin: 0;
                padding: 0;
                width: 100%;
                height: 100%;
                min-height: 100%;
                min-height: 100vh;
                color: #f7f7f7;
                overflow: hidden;
                overscroll-behavior-y: none;
                touch-action: manipulation;
            }

            html {
                background: #000000;
            }

            html::before {
                content: "";
                position: fixed;
                inset: 0;
                z-index: -2;
                pointer-events: none;
            }

            html::after {
                content: "";
                position: fixed;
                inset: 0;
                background: radial-gradient(circle at top, rgba(64, 104, 161, 0.2), transparent 42%),
                    linear-gradient(180deg, rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.5));
                z-index: -1;
                pointer-events: none;
            }

            body {
                background: transparent;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
                -webkit-text-size-adjust: 100%;
                padding: max(20px, env(safe-area-inset-top)) 16px max(20px, env(safe-area-inset-bottom));
                box-sizing: border-box;
                display: grid;
                place-items: center;
                overflow: hidden;
            }

            .login-shell {
                width: min(100%, 420px);
                position: relative;
            }

            .login-panel {
                background: rgba(26, 26, 28, 0.7);
                border: 1px solid rgba(255, 255, 255, 0.14);
                border-radius: 16px;
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
                box-shadow: 0 18px 42px rgba(0, 0, 0, 0.38);
                padding: 18px;
                position: relative;
                display: grid;
                gap: 12px;
            }

            .password-input {
                width: 100%;
                height: 52px;
                box-sizing: border-box;
                border: 1px solid rgba(255, 255, 255, 0.16);
                border-radius: 12px;
                background: rgba(48, 48, 48, 0.6);
                color: #f3f3f3;
                font-size: 1rem;
                padding: 0 14px;
                outline: none;
                transition: border-color 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
            }

            .password-input::placeholder {
                color: rgba(214, 214, 219, 0.62);
            }

            .password-input:hover {
                border-color: rgba(160, 200, 255, 0.5);
                background: rgba(56, 56, 56, 0.68);
            }

            .password-input:focus {
                border-color: rgba(116, 176, 255, 0.95);
                box-shadow: 0 0 0 3px rgba(88, 152, 235, 0.26);
                background: rgba(60, 60, 60, 0.76);
            }

            .confirm-button {
                width: 100%;
                height: 50px;
                border: 1px solid rgba(98, 162, 252, 0.85);
                border-radius: 12px;
                background: rgba(66, 128, 214, 0.8);
                color: #f3f3f3;
                font-size: 0.98rem;
                font-weight: 600;
                cursor: pointer;
                transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
            }

            .confirm-button:hover,
            .confirm-button:focus-visible {
                background: rgba(80, 145, 235, 0.92);
                box-shadow: 0 10px 24px rgba(33, 93, 173, 0.28);
                outline: none;
            }

            .confirm-button:active {
                transform: scale(0.99);
            }

            .toast {
                position: absolute;
                left: 0;
                right: 0;
                bottom: calc(100% + 0.5rem);
                transform: translateY(12px);
                box-sizing: border-box;
                padding: 12px 14px;
                border-radius: 12px;
                border: 1px solid rgba(255, 126, 126, 0.28);
                background: rgba(71, 25, 25, 0.76);
                color: #ffe5e5;
            
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                box-shadow: 0 14px 28px rgba(0, 0, 0, 0.28);
                opacity: 0;
                visibility: hidden;
                pointer-events: none;
                transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
                z-index: 20;
            }

            .toast.show {
                opacity: 1;
                visibility: visible;
                transform: translateY(0);
                transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s;
            }

            @@media (max-width: 760px) {
                .login-panel {
                    border-radius: 16px;
                    padding: 16px;
                }

                .password-input,
                .confirm-button {
                    font-size: 16px;
                }
            }
    </style>
</head>

<body>
    <main class="login-shell">
        <div id="errorToast" class="toast" role="status" aria-live="polite"></div>
        <section class="login-panel">
            <input id="keyInput" class="password-input" type="password" placeholder="Key" />
            <button class="confirm-button" type="button" id="ok">Ok</button>
        </section>
    </main>

    <script>
            const keyInput = document.querySelector("#keyInput");
            const errorToast = document.querySelector("#errorToast");
            let toastTimerId = null;

            function showToast(message) {
                errorToast.textContent = message;
                errorToast.classList.add("show");
                if (toastTimerId) {
                    clearTimeout(toastTimerId);
                }
                toastTimerId = setTimeout(() => {
                    errorToast.classList.remove("show");
                }, 2200);
            }

            async function TestPassword(password) {
                return await fetch(
                    `/api/a/key`,
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/x-www-form-urlencoded; charset=utf-8",
                        },
                        body: new URLSearchParams({ key: password }).toString()
                    }
                ).then(res => {
                    if(res.ok) {
                        return res.text();
                    } else {
                        throw new Error("网络错误，请稍后再试");
                    }
                })
            }

            document.querySelector("#ok").addEventListener('click',async () => {
                const key = keyInput.value;
                if (!key) {
                    showToast("请输入密码");
                    keyInput.focus();
                    return;
                }

                const result = await TestPassword(key).catch(err => {
                    showToast(err.message);
                });
                if (result == "1") {

                    document.cookie = `Auth-Key=${key}; expires=Fri, 31 Dec 9999 23:59:59 GMT; path=/`;
                    window.location.href = "@Model.OriginalPath";
                } else if(result == "0") {
                    keyInput.value = "";
                    showToast("密码错误，请重试");
                    keyInput.focus();
                }
            })

            keyInput.addEventListener('keypress', (event) => {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    document.querySelector("#ok").click();
                }
            });
    </script>
</body>

</html>