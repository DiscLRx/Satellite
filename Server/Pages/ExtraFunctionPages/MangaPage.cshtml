@page "/ex/manga/{locationNameBase64}/{relativePathBase64?}"
@using Server.Tools.Encoding
@model Server.Pages.ExtraFunctionPages.MangaPage

@{
    Layout = null;
    var browseHref = $"/b/{Base64.ToBase64Url(Model.LocationName)}/{Base64.ToBase64Url(Model.RelativePath)}";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"/>
    <meta name="format-detection" content="telephone=no,email=no,address=no"/>
    <title>Manga Player</title>
    @await Html.PartialAsync("/Pages/Shared/_SatelliteTheme.cshtml")
    <style>
        html,
        body {
            width: 100%;
            min-height: 100%;
        }

        html::before {
            content: "";
            position: fixed;
            inset: 0;
            background-image: var(--html-bg-image, none);
            background-position: center center;
            background-size: var(--html-bg-size, cover);
            background-repeat: no-repeat;
            background-attachment: fixed;
            filter: var(--html-bg-filter, none);
            transform: scale(1.03);
            z-index: -2;
            pointer-events: none;
        }

        html::after {
            content: "";
            position: fixed;
            inset: 0;
            background-image: var(--front-bg-image, none);
            background-position: center center;
            background-size: var(--front-bg-size, contain);
            background-repeat: no-repeat;
            pointer-events: none;
            z-index: -1;
        }

        body {
            margin: 0;
            padding: 10px;
            box-sizing: border-box;
            overflow: hidden;
            overscroll-behavior-y: none;
            touch-action: manipulation;
            display: flex;
            flex-direction: column;
            background-color: rgba(6, 10, 16, 0.22);
            transition: background-color 0.22s ease;
        }

        body.is-light-off {
            background-color: rgba(6, 10, 16, 0.84);
        }

        .manga-shell {
            width: min(1120px, 100%);
            margin: 0 auto;
            min-height: calc(100dvh - 20px);
            display: grid;
            grid-template-rows: auto minmax(0, 1fr) auto;
            gap: 8px;
        }

        .top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            padding: 10px 12px;
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 20px;
            backdrop-filter: blur(var(--glass-blur));
            -webkit-backdrop-filter: blur(var(--glass-blur));
            box-shadow: var(--shadow);
            z-index: 120;
        }

        .title-wrap {
            min-width: 0;
        }

        .top-actions {
            display: inline-flex;
            align-items: center;
            justify-content: flex-end;
            gap: 6px;
            flex: 0 0 auto;
        }

        .theme-light-toggle {
            min-width: 44px;
            width: 44px;
            padding: 0;
        }

        .eyebrow {
            margin: 0;
            color: var(--accent-strong);
            font-size: 0.72rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .title {
            margin: 4px 0 0;
            font-size: clamp(1.18rem, 2.4vw, 1.48rem);
            color: var(--text);
            line-height: 1.15;
        }

        .subtitle {
            margin: 4px 0 0;
            color: var(--text-muted);
            font-size: 0.82rem;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .theme-light-toggle .icon-light-on,
        .theme-light-toggle .icon-light-off {
            display: none;
            width: 18px;
            height: 18px;
        }

        .theme-light-toggle[data-light="off"] .icon-light-off,
        .theme-light-toggle[data-light="on"] .icon-light-on {
            display: block;
        }

        .viewer {
            min-height: 0;
            display: flex;
            margin-bottom: 10px;
        }

        .frame-panel {
            position: relative;
            width: 100%;
            min-height: 0;
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: 22px;
            box-shadow: var(--shadow);
            backdrop-filter: blur(var(--glass-blur));
            -webkit-backdrop-filter: blur(var(--glass-blur));
        }

        .image-stage.frame-panel {
            height: 100%;
        }

        .image-stage {
            display: block;
            overflow: hidden;
        }

        .image-surface.is-hidden {
            display: none;
        }

        #scrollList {
            display: none;
        }

        #scrollList.is-active {
            display: flex;
            flex-direction: column;
            position: absolute;
            inset: 0;
            overflow-y: auto;
            overflow-x: hidden;
            gap: 8px;
            padding: 10px;
            box-sizing: border-box;
            scrollbar-width: thin;
            scrollbar-color: rgba(100, 100, 100, 0.35) transparent;
        }

        .scroll-item {
            width: 100%;
            flex-shrink: 0;
            border-radius: 12px;
            border: 1px solid rgba(122, 167, 191, 0.14);
            background: rgba(255, 255, 255, 0.02);
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .scroll-image {
            width: 100%;
            max-width: 100%;
            height: auto;
            max-height: 100%;
            display: block;
            object-fit: contain;
        }

        .image-surface {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            display: block;
            object-fit: contain;
            user-select: none;
            cursor: pointer;
        }

        .empty {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: min(100%, 520px);
            color: var(--text-muted);
            font-size: 0.95rem;
            text-align: center;
            padding: 0 16px;
            box-sizing: border-box;
        }

        .control-bar {
            padding: 8px;
            display: flex;
            flex-direction: row;
            align-items: stretch;
            gap: 6px;
            z-index: 180;
        }

        .controls-base {
            flex: 1 1 auto;
            min-width: 0;
            display: grid;
            grid-template-columns: minmax(42px, 0.9fr) minmax(42px, 0.9fr) minmax(72px, 1.5fr) minmax(42px, 0.9fr);
            align-items: center;
            gap: 6px;
        }

        .controls-extra-wrap {
            flex: 0 0 auto;
        }

        .controls-extra {
            height: 100%;
            display: grid;
            grid-template-columns: minmax(84px, 1.8fr) minmax(42px, 0.8fr);
            align-items: center;
            gap: 6px;
        }

        #menuToggleBtn {
            display: none;
        }

        .controls-base > *,
        .controls-extra > * {
            min-width: 0;
        }

        .btn,
        .interval,
        .jump-input {
            height: 36px;
            border-radius: 14px;
            font-size: 0.9rem;
            box-sizing: border-box;
        }

        .btn {
            width: 100%;
            padding: 0 10px;
            min-height: 42px;
            border: 1px solid rgba(255, 138, 61, 0.34);
            background: rgba(255, 138, 61, 0.08);
            color: var(--text);
            cursor: pointer;
            transition: border-color 0.18s ease, background-color 0.18s ease;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .btn:hover,
        .btn:focus-visible {
            border-color: rgba(255, 138, 61, 0.52);
            background: rgba(255, 138, 61, 0.14);
            outline: none;
        }

        .btn:active {
            background: rgba(255, 138, 61, 0.18);
        }

        .btn:disabled {
            opacity: 0.45;
            cursor: not-allowed;
            box-shadow: none;
        }

        #togglePlay,
        #modeToggleBtn,
        #menuToggleBtn,
        #prevBtn,
        #nextBtn {
            min-width: 42px;
            width: 100%;
            padding: 0;
        }

        .control-icon {
            width: 18px;
            height: 18px;
            display: block;
        }

        #togglePlay .icon-play,
        #togglePlay .icon-pause,
        #modeToggleBtn .icon-mode-page,
        #modeToggleBtn .icon-mode-scroll,
        #menuToggleBtn .icon-menu-off,
        #menuToggleBtn .icon-menu-on {
            display: none;
        }

        #togglePlay[data-playing="off"] .icon-play,
        #togglePlay[data-playing="on"] .icon-pause,
        #modeToggleBtn[data-mode="page"] .icon-mode-page,
        #modeToggleBtn[data-mode="scroll"] .icon-mode-scroll,
        #menuToggleBtn[data-active="off"] .icon-menu-off,
        #menuToggleBtn[data-active="on"] .icon-menu-on {
            display: block;
        }

        #modeToggleBtn[data-mode="page"] {
            border-color: rgba(89, 196, 207, 0.34);
            background: rgba(89, 196, 207, 0.09);
        }

        #modeToggleBtn[data-mode="scroll"] {
            border-color: rgba(255, 138, 61, 0.54);
            background: rgba(255, 138, 61, 0.16);
        }

        #menuToggleBtn[data-active="off"] {
            border-color: rgba(89, 196, 207, 0.34);
            background: rgba(89, 196, 207, 0.09);
        }

        #menuToggleBtn[data-active="off"]:hover,
        #menuToggleBtn[data-active="off"]:focus-visible {
            border-color: rgba(89, 196, 207, 0.52);
            background: rgba(89, 196, 207, 0.15);
        }

        #menuToggleBtn[data-active="on"] {
            border-color: rgba(255, 138, 61, 0.54);
            background: rgba(255, 138, 61, 0.16);
        }

        .interval,
        .jump-input {
            border: 1px solid var(--line);
            background: rgba(255, 255, 255, 0.04);
            color: var(--text);
            text-align: center;
            padding: 0 6px;
            min-height: 42px;
        }

        .interval-wrap {
            position: relative;
            width: 100%;
            min-width: 0;
            max-width: none;
        }

        .interval {
            width: 100%;
            padding-right: 20px;
        }

        .interval-unit {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 0.8rem;
            pointer-events: none;
            user-select: none;
        }

        .interval:focus,
        .jump-input:focus {
            outline: 1px solid rgba(89, 196, 207, 0.5);
            border-color: rgba(89, 196, 207, 0.5);
        }

        .status {
            color: var(--text-muted);
            display: flex;
            align-items: center;
            justify-content: flex-start;
            gap: 4px;
            min-width: 0;
            width: 100%;
            font-size: 0.82rem;
            min-height: 42px;
            height: 42px;
            padding: 0 3px;
            box-sizing: border-box;
            border: 1px solid var(--line);
            border-radius: 12px;
            background: rgba(255, 255, 255, 0.035);
            transition: border-color 0.18s ease, background 0.18s ease;
        }

        .status:focus-within {
            border-color: rgba(89, 196, 207, 0.5);
            background: rgba(255, 255, 255, 0.05);
        }

        .status-label {
            white-space: nowrap;
            flex: 0 0 auto;
            min-width: 44px;
            padding: 0 8px;
            min-height: 34px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            background: rgba(89, 196, 207, 0.1);
            color: #dff4f8;
        }

        .jump-input {
            width: 100%;
            min-width: 0;
            max-width: none;
            font-size: 0.82rem;
            border: none;
            background: transparent;
            min-height: 34px;
            padding: 0 8px;
        }

        .jump-input:focus {
            outline: none;
            border-color: transparent;
        }

        input[type="number"]::-webkit-outer-spin-button,
        input[type="number"]::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type="number"] {
            -moz-appearance: textfield;
            appearance: textfield;
        }

        @@media (max-width: 900px) {
            body {
                padding: 0;
                background-color: rgba(6, 10, 16, 0.16);
                --overlay-gap-left: max(6px, env(safe-area-inset-left));
                --overlay-gap-right: max(6px, env(safe-area-inset-right));
                --overlay-width: calc(100% - var(--overlay-gap-left) - var(--overlay-gap-right));
                --control-floating-gap: 10px;
                --control-bar-base-height: 48px;
            }

            .manga-shell {
                width: 100%;
                min-height: 100dvh;
                gap: 0;
                grid-template-rows: minmax(0, 1fr);
            }

            .top-bar {
                display: none;
                position: fixed;
                top: max(6px, env(safe-area-inset-top));
                left: 50%;
                width: min(1120px, var(--overlay-width));
                transform: translateX(-50%);
                border-radius: 16px;
                box-shadow: none;
                padding: 8px 10px;
                z-index: 260;
            }

            body.menu-active .top-bar {
                display: flex;
            }

            .frame-panel {
                border-radius: 16px;
                box-shadow: none;
            }

            .viewer {
                padding: max(6px, env(safe-area-inset-top)) var(--overlay-gap-right) calc(var(--control-floating-gap) + var(--control-bar-base-height) + max(6px, env(safe-area-inset-bottom))) var(--overlay-gap-left);
                margin-bottom: 0;
            }

            .scroll-stage {
                padding: 8px;
            }

            .scroll-list {
                gap: 6px;
            }

            .scroll-item {
                border-radius: 10px;
            }

            .control-bar {
                position: fixed;
                left: 50%;
                width: min(1120px, var(--overlay-width));
                transform: translateX(-50%);
                bottom: max(6px, env(safe-area-inset-bottom));
                padding: 6px;
                border-radius: 16px;
                display: grid;
                grid-template-rows: auto 0fr;
                align-items: stretch;
                overflow: hidden;
                transition: grid-template-rows 0.18s ease;
            }

            body.menu-active .control-bar {
                grid-template-rows: auto 1fr;
            }

            .controls-base {
                flex: unset;
                gap: 4px;
                grid-template-columns: minmax(38px, 0.9fr) minmax(38px, 0.9fr) minmax(70px, 1.45fr) minmax(38px, 0.9fr) minmax(38px, 0.9fr);
            }

            .controls-extra-wrap {
                min-height: 0;
                overflow: hidden;
            }

            .controls-extra {
                height: unset;
                gap: 4px;
                grid-template-columns: minmax(72px, 1.8fr) minmax(38px, 0.8fr);
            }

            #menuToggleBtn {
                display: inline-flex;
            }

            .btn,
            .interval,
            .jump-input {
                min-height: 36px;
                border-radius: 10px;
                font-size: 0.82rem;
            }

            #togglePlay,
            #modeToggleBtn,
            #menuToggleBtn,
            #prevBtn,
            #nextBtn {
                min-width: 38px;
                width: 100%;
            }

            .interval-wrap {
                width: 56px;
            }

            .status {
                width: 100%;
                min-width: 0;
                min-height: 36px;
                height: 36px;
                padding: 0 2px;
            }

            .jump-input {
                width: 100%;
                min-height: 32px;
                padding: 0 6px;
            }

            .status-label {
                min-width: 38px;
                min-height: 32px;
                padding: 0 6px;
            }
        }

    </style>
</head>
<body>
<div class="manga-shell">
    <header id="topBar" class="top-bar">
        <div class="title-wrap">
            <p class="eyebrow">Satellite</p>
            <h1 class="title">Manga</h1>
            <p class="subtitle">@Model.LocationName / @(string.IsNullOrWhiteSpace(Model.RelativePath) ? "/" : Model.RelativePath)</p>
        </div>
        <div class="top-actions">
            <button id="lightToggleBtn" class="theme-link theme-light-toggle" type="button" data-light="on" aria-label="开灯" title="开灯" aria-pressed="false">
                <img class="icon-light-on" src="/api/res/icon/btn-light-on.svg" alt="开灯" aria-hidden="true"/>
                <img class="icon-light-off" src="/api/res/icon/btn-light-off.svg" alt="关灯" aria-hidden="true"/>
            </button>
            <a class="theme-link" href="@browseHref">返回 Browse</a>
        </div>
    </header>

    <main class="viewer">
        <section class="image-stage frame-panel" aria-label="图片展示区">
            @if (Model.ImageUrlList.Count == 0)
            {
                <div class="empty">未找到可播放的图片（支持 jpg/jpeg/png/webp/gif/bmp/avif）</div>
            }
            else
            {
                <img id="viewerImage" class="image-surface" alt="manga image" decoding="sync"/>
            }
            <div id="scrollList"></div>
        </section>
    </main>

    <footer class="control-bar frame-panel">
        <div class="controls-base">
            <button id="togglePlay" class="btn" type="button" data-playing="off" aria-label="播放" title="播放">
                <img class="control-icon icon-play" src="/api/res/icon/player-play.svg" alt="播放" aria-hidden="true"/>
                <img class="control-icon icon-pause" src="/api/res/icon/player-pause.svg" alt="暂停" aria-hidden="true"/>
            </button>
            <button id="prevBtn" class="btn" type="button" aria-label="上一页" title="上一页">
                <img class="control-icon" src="/api/res/icon/btn-prev.svg" alt="上一页" aria-hidden="true"/>
            </button>
            <div id="statusText" class="status">
                <input id="jumpInput" class="jump-input" type="number" min="1" step="1" value="1" aria-label="跳转到第几张"/>
                <span id="totalCountLabel" class="status-label">/ 0</span>
            </div>
            <button id="nextBtn" class="btn" type="button" aria-label="下一页" title="下一页">
                <img class="control-icon" src="/api/res/icon/btn-next.svg" alt="下一页" aria-hidden="true"/>
            </button>
            <button id="menuToggleBtn" class="btn" type="button" data-active="off" aria-label="菜单" title="菜单" aria-pressed="false">
                <img class="control-icon icon-menu-off" src="/api/res/icon/btn-menu-off.svg" alt="菜单" aria-hidden="true"/>
                <img class="control-icon icon-menu-on" src="/api/res/icon/btn-menu-on.svg" alt="收起菜单" aria-hidden="true"/>
            </button>
        </div>
        <div class="controls-extra-wrap">
            <div id="menuExtraPanel" class="controls-extra">
                <div class="interval-wrap">
                    <input id="intervalInput" class="interval" type="number" min="0.5" step="0.5" value="3" aria-label="播放间隔（秒）"/>
                    <span class="interval-unit">s</span>
                </div>
                <button id="modeToggleBtn" class="btn" type="button" data-mode="page" aria-label="翻页模式" title="翻页模式">
                    <img class="control-icon icon-mode-page" src="/api/res/icon/mode-page-openbook-b.svg" alt="翻页模式" aria-hidden="true"/>
                    <img class="control-icon icon-mode-scroll" src="/api/res/icon/mode-scroll-a.svg" alt="滚动模式" aria-hidden="true"/>
                </button>
            </div>
        </div>
    </footer>
</div>

<script>
    const imageList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ImageUrlList));
    const viewerImage = document.getElementById("viewerImage");
    const togglePlay = document.getElementById("togglePlay");
    const intervalInput = document.getElementById("intervalInput");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const jumpInput = document.getElementById("jumpInput");
    const totalCountLabel = document.getElementById("totalCountLabel");
    const lightToggleBtn = document.getElementById("lightToggleBtn");
    const menuToggleBtn = document.getElementById("menuToggleBtn");
    const modeToggleBtn = document.getElementById("modeToggleBtn");
    const imageStage = document.querySelector(".image-stage");
    const scrollList = document.getElementById("scrollList");
    const mobileMediaQuery = window.matchMedia("(max-width: 900px)");

    const lightModeStorageKey = "lightMode";
    const legacyLightModeStorageKey = "liteplay.lightMode";

    function isMobileViewport() {
        return mobileMediaQuery.matches;
    }

    function readLightMode() {
        try {
            const currentValue = (window.localStorage.getItem(lightModeStorageKey) || "").toLowerCase();
            if (currentValue === "on" || currentValue === "off") {
                return currentValue;
            }

            const legacyValue = (window.localStorage.getItem(legacyLightModeStorageKey) || "").toLowerCase();
            if (legacyValue === "on" || legacyValue === "off") {
                window.localStorage.setItem(lightModeStorageKey, legacyValue);
                return legacyValue;
            }

            return "";
        } catch {
            return "";
        }
    }

    function writeLightMode(mode) {
        try {
            window.localStorage.setItem(lightModeStorageKey, mode);
        } catch {
        }
    }

    function syncLightToggleUi() {
        if (!lightToggleBtn) {
            return;
        }

        const isLightOff = document.body.classList.contains("is-light-off");
        lightToggleBtn.dataset.light = isLightOff ? "off" : "on";
        lightToggleBtn.setAttribute("aria-label", isLightOff ? "开灯" : "关灯");
        lightToggleBtn.setAttribute("title", isLightOff ? "开灯" : "关灯");
        lightToggleBtn.setAttribute("aria-pressed", isLightOff ? "true" : "false");
    }

    function restoreLightModeFromStorage() {
        if (isMobileViewport()) {
            document.body.classList.add("is-light-off");
            return;
        }

        const storedMode = readLightMode();
        if (storedMode === "off") {
            document.body.classList.add("is-light-off");
            return;
        }

        if (storedMode === "on") {
            document.body.classList.remove("is-light-off");
        }
    }

    function toggleLightMask() {
        if (isMobileViewport()) {
            document.body.classList.add("is-light-off");
            syncLightToggleUi();
            return;
        }

        document.body.classList.toggle("is-light-off");
        const lightMode = document.body.classList.contains("is-light-off") ? "off" : "on";
        writeLightMode(lightMode);
        syncLightToggleUi();
    }

    function syncLightModeForViewport() {
        restoreLightModeFromStorage();
        syncLightToggleUi();
    }

    function syncPlayButtonUi() {
        if (!togglePlay) {
            return;
        }

        const mode = isPlaying ? "on" : "off";
        togglePlay.dataset.playing = mode;
        togglePlay.setAttribute("aria-label", isPlaying ? "暂停" : "播放");
        togglePlay.setAttribute("title", isPlaying ? "暂停" : "播放");
    }

    function syncMenuUi() {
        if (!menuToggleBtn) {
            return;
        }

        const isMenuActive = document.body.classList.contains("menu-active");
        menuToggleBtn.dataset.active = isMenuActive ? "on" : "off";
        menuToggleBtn.setAttribute("aria-pressed", isMenuActive ? "true" : "false");
    }

    function closeMenu() {
        document.body.classList.remove("menu-active");
        syncMenuUi();
    }

    function toggleMenu() {
        document.body.classList.toggle("menu-active");
        syncMenuUi();
    }

    const MAX_DECODE_QUEUE = 3;
    let currentIndex = 0;
    let isPlaying = false;
    let timerId = null;
    let renderToken = 0;
    let currentEntry = null;
    let decodeQueue = [];
    let decodeCursor = 0;
    let isQueueLoading = false;
    let viewMode = "page";
    let scrollItemsLoaded = false;

    function syncViewModeUi() {
        if (modeToggleBtn) {
            modeToggleBtn.dataset.mode = viewMode;
            modeToggleBtn.setAttribute("aria-label", viewMode === "page" ? "翻页模式" : "滚动模式");
            modeToggleBtn.setAttribute("title", viewMode === "page" ? "翻页模式" : "滚动模式");
        }

        viewerImage?.classList.toggle("is-hidden", viewMode === "scroll");
        scrollList?.classList.toggle("is-active", viewMode === "scroll");
    }

    async function ensureScrollItemsLoaded() {
        if (scrollItemsLoaded || !scrollList) {
            return;
        }

        const markup = imageList.map((url, index) => `\n            <article class="scroll-item" data-index="${index}">\n                <img class="scroll-image" src="${url}" alt="manga image ${index + 1}" loading="lazy" decoding="async"/>\n            </article>`).join("");
        scrollList.innerHTML = markup;

        // 计算滚动容器的可用高度
        if (imageStage) {
            const stageHeight = imageStage.clientHeight;
            const scrollListHeight = stageHeight - 20; // 20px = 上下 padding 10px
            const scrollItems = scrollList.querySelectorAll(".scroll-item");
            scrollItems.forEach(item => {
                item.style.maxHeight = scrollListHeight + "px";
            });
        }

        scrollItemsLoaded = true;
    }

    async function syncScrollPosition(index) {
        if (viewMode !== "scroll") {
            return;
        }

        await ensureScrollItemsLoaded();
        const target = scrollList?.querySelector(`[data-index="${index}"]`);
        if (target && scrollList) {
            scrollList.scrollTo({top: target.offsetTop, behavior: "smooth"});
        }
    }

    async function toggleViewMode() {
        viewMode = viewMode === "page" ? "scroll" : "page";
        syncViewModeUi();
        if (viewMode === "scroll") {
            await ensureScrollItemsLoaded();
            await syncScrollPosition(currentIndex);
        }
    }

    function updateStatus() {
        if (!jumpInput || !totalCountLabel) {
            return;
        }

        if (imageList.length === 0) {
            jumpInput.value = "0";
            totalCountLabel.textContent = "/ 0";
            return;
        }

        totalCountLabel.textContent = `/ ${imageList.length}`;
        if (document.activeElement !== jumpInput) {
            jumpInput.value = `${currentIndex + 1}`;
        }
    }

    function revokeEntry(entry) {
        if (entry?.isObjectUrl && entry.url) {
            URL.revokeObjectURL(entry.url);
        }
    }

    function waitForImageDecode(url) {
        return new Promise((resolve) => {
            const image = new Image();
            let settled = false;

            const done = (success) => {
                if (settled) {
                    return;
                }
                settled = true;
                resolve(success);
            };

            image.decoding = "sync";
            image.onload = () => done(true);
            image.onerror = () => done(false);
            image.src = url;

            if (typeof image.decode === "function") {
                image.decode().then(() => done(true)).catch(() => {
                });
            }

            if (image.complete && image.naturalWidth > 0) {
                done(true);
            }
        });
    }

    async function loadDecodedEntry(index) {
        const response = await fetch(imageList[index], {method: "GET"});
        if (!response.ok) {
            throw new Error(`Image load failed: ${response.status}`);
        }

        const blob = await response.blob();
        const objectUrl = URL.createObjectURL(blob);
        const decodeSuccess = await waitForImageDecode(objectUrl);
        if (!decodeSuccess) {
            URL.revokeObjectURL(objectUrl);
            throw new Error("Image decode failed");
        }
        return {
            index,
            url: objectUrl,
            isObjectUrl: true,
        };
    }

    async function loadDisplayEntry(index) {
        try {
            return await loadDecodedEntry(index);
        } catch {
            const fallbackUrl = imageList[index];
            const decodeSuccess = await waitForImageDecode(fallbackUrl);
            if (!decodeSuccess) {
                throw new Error("Image fallback decode failed");
            }
            return {
                index,
                url: fallbackUrl,
                isObjectUrl: false,
            };
        }
    }

    function applyViewerEntry(entry) {
        if (!viewerImage) {
            revokeEntry(entry);
            return;
        }

        const previousEntry = currentEntry;
        currentEntry = entry;
        viewerImage.src = entry.url;
        if (previousEntry && previousEntry !== entry) {
            revokeEntry(previousEntry);
        }

        updateStatus();
        if (viewMode === "scroll") {
            void syncScrollPosition(currentIndex);
        }
    }

    function clearDecodeQueue() {
        for (const item of decodeQueue) {
            revokeEntry(item);
        }
        decodeQueue = [];
    }

    async function fillDecodeQueue() {
        if (isQueueLoading || imageList.length <= 1) {
            return;
        }

        isQueueLoading = true;
        try {
            const targetSize = Math.min(MAX_DECODE_QUEUE, imageList.length - 1);
            let attempts = 0;

            while (decodeQueue.length < targetSize && attempts < imageList.length * 2) {
                const indexToLoad = decodeCursor;
                decodeCursor = (decodeCursor + 1) % imageList.length;
                attempts += 1;

                if (indexToLoad === currentIndex || decodeQueue.some((item) => item.index === indexToLoad)) {
                    continue;
                }

                try {
                    const entry = await loadDisplayEntry(indexToLoad);
                    if (entry.index === currentIndex || decodeQueue.some((item) => item.index === entry.index)) {
                        revokeEntry(entry);
                        continue;
                    }
                    decodeQueue.push(entry);
                } catch {
                }
            }
        } finally {
            isQueueLoading = false;
        }
    }

    function resetDecodeQueue() {
        if (imageList.length <= 1) {
            return;
        }

        clearDecodeQueue();
        decodeCursor = (currentIndex + 1) % imageList.length;
        void fillDecodeQueue();
    }

    async function displayIndex(targetIndex) {
        const token = ++renderToken;
        const queuedIndex = decodeQueue.findIndex((item) => item.index === targetIndex);

        if (queuedIndex !== -1) {
            const entry = decodeQueue.splice(queuedIndex, 1)[0];
            if (token !== renderToken) {
                revokeEntry(entry);
                return;
            }

            currentIndex = targetIndex;
            applyViewerEntry(entry);
            resetDecodeQueue();
            return;
        }

        const entry = await loadDisplayEntry(targetIndex);
        if (token !== renderToken) {
            revokeEntry(entry);
            return;
        }

        currentIndex = targetIndex;
        applyViewerEntry(entry);
        resetDecodeQueue();
    }

    async function renderCurrentImage() {
        if (!viewerImage || imageList.length === 0) {
            return;
        }

        await displayIndex(currentIndex);
    }

    function stopPlay() {
        if (timerId !== null) {
            clearInterval(timerId);
            timerId = null;
        }

        isPlaying = false;
        syncPlayButtonUi();
    }

    function getIntervalMs() {
        const value = Number(intervalInput?.value ?? "3");
        const safe = Number.isFinite(value) && value > 0 ? value : 3;
        return Math.max(500, Math.round(safe * 1000));
    }

    async function nextImage() {
        if (imageList.length === 0) {
            return;
        }

        const targetIndex = (currentIndex + 1) % imageList.length;
        try {
            await displayIndex(targetIndex);
        } catch {
        }
    }

    async function prevImage() {
        if (imageList.length === 0) {
            return;
        }

        const targetIndex = (currentIndex - 1 + imageList.length) % imageList.length;
        try {
            await displayIndex(targetIndex);
        } catch {
        }
    }

    function startPlay() {
        if (imageList.length <= 1) {
            return;
        }

        stopPlay();
        timerId = setInterval(nextImage, getIntervalMs());
        isPlaying = true;
        syncPlayButtonUi();
    }

    async function jumpToImageFromInput() {
        if (imageList.length === 0 || !jumpInput) {
            return;
        }

        const previousIndex = currentIndex;
        const previousPage = `${previousIndex + 1}`;
        const raw = Number(jumpInput.value);
        const target = Math.round(raw);
        const isValid = Number.isFinite(raw) && target >= 1 && target <= imageList.length;

        if (!isValid) {
            jumpInput.value = previousPage;
            return;
        }

        try {
            await displayIndex(target - 1);
        } catch {
            jumpInput.value = previousPage;
            if (previousIndex !== currentIndex) {
                try {
                    await displayIndex(previousIndex);
                } catch {
                }
            }
        }
    }

    togglePlay?.addEventListener("click", () => {
        if (isPlaying) {
            stopPlay();
        } else {
            startPlay();
        }
    });

    prevBtn?.addEventListener("click", () => {
        void prevImage();
    });

    nextBtn?.addEventListener("click", () => {
        void nextImage();
    });

    menuToggleBtn?.addEventListener("click", toggleMenu);
    modeToggleBtn?.addEventListener("click", () => {
        void toggleViewMode();
    });

    viewerImage?.addEventListener("click", (event) => {
        const rect = viewerImage.getBoundingClientRect();
        const clickX = event.clientX - rect.left;
        if (clickX < rect.width / 2) {
            void prevImage();
        } else {
            void nextImage();
        }
    });

    jumpInput?.addEventListener("keydown", (event) => {
        if (event.key === "Enter") {
            event.preventDefault();
            void jumpToImageFromInput();
            jumpInput.blur();
        }
    });

    jumpInput?.addEventListener("blur", () => {
        void jumpToImageFromInput();
    });

    intervalInput?.addEventListener("change", () => {
        if (isPlaying) {
            startPlay();
        }
    });

    lightToggleBtn?.addEventListener("click", toggleLightMask);
    mobileMediaQuery.addEventListener("change", () => {
        syncLightModeForViewport();
        closeMenu();
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "ArrowLeft") {
            void prevImage();
        } else if (event.key === "ArrowRight") {
            void nextImage();
        } else if (event.key === "Escape") {
            closeMenu();
        } else if (event.code === "Space") {
            event.preventDefault();
            if (isPlaying) {
                stopPlay();
            } else {
                startPlay();
            }
        }
    });

    updateStatus();
    syncLightModeForViewport();
    syncPlayButtonUi();
    syncMenuUi();
    syncViewModeUi();
    void renderCurrentImage();

    if (jumpInput) {
        jumpInput.max = `${imageList.length}`;
    }

    if (imageList.length <= 1) {
        togglePlay?.setAttribute("disabled", "disabled");
    }

    if (imageList.length === 0) {
        jumpInput?.setAttribute("disabled", "disabled");
    }
</script>

<script>
    async function loadBackgroundImage(windowWhRate) {
        const imageType = windowWhRate > 1 ? "horizontal" : "vertical";
        const response = await fetch(`/api/bg?imageType=${imageType}`, {method: "GET"});
        if (!response.ok) {
            return null;
        }

        const blob = await response.blob();
        return URL.createObjectURL(blob);
    }

    let windowWhRate = window.innerWidth / window.innerHeight;
    let bgUrl = null;

    async function setBackground() {
        const previousRate = windowWhRate;
        windowWhRate = window.innerWidth / window.innerHeight;

        if (bgUrl === null || (previousRate > 1 && windowWhRate <= 1) || (previousRate <= 1 && windowWhRate > 1)) {
            bgUrl = await loadBackgroundImage(windowWhRate);
        }

        const htmlElement = document.documentElement;
        if (bgUrl === null) {
            htmlElement.style.setProperty("--html-bg-image", "none");
            htmlElement.style.setProperty("--front-bg-image", "none");
            return;
        }

        const img = new Image();
        img.src = bgUrl;
        await img.decode();
        const imgWhRate = img.width / img.height;

        htmlElement.style.setProperty("--html-bg-image", `url("${bgUrl}")`);
        htmlElement.style.setProperty("--html-bg-size", "cover");

        if ((windowWhRate > imgWhRate && windowWhRate > 1.7) || (windowWhRate < imgWhRate && windowWhRate < 0.3)) {
            htmlElement.style.setProperty("--html-bg-filter", "blur(4.8px) brightness(0.45)");
            htmlElement.style.setProperty("--front-bg-image", `url("${bgUrl}")`);
            htmlElement.style.setProperty("--front-bg-size", "contain");
        } else {
            htmlElement.style.setProperty("--html-bg-filter", "none");
            htmlElement.style.setProperty("--front-bg-image", "none");
            htmlElement.style.setProperty("--front-bg-size", "cover");
        }
    }

    window.addEventListener("resize", setBackground);
    void setBackground();
</script>
</body>
</html>
