<script>
    const locationBase64 = "@Model.LocationBase64";
    const pathBase64 = "@Model.PathBase64";

    const savedScriptsPayload = @Html.Raw(Model.LocationVideoFilterScriptsJson);

    function normalizeFilterScriptBody(script) {
        const text = (script || "").trim();
        if (!text) return "return true;";
        if (/\breturn\b/.test(text)) return text;
        return `return (${text.replace(/;+$/g, "").trim()});`;
    }


    const iconUrls = {
        sequence: "/api/res/icon/btn-sequence.svg",
        shuffle: "/api/res/icon/btn-shuffle.svg",
        repeat: "/api/res/icon/btn-repeat.svg"
    };

    const playerKindIconUrls = {
        native: "/api/res/icon/btn-player-native.svg",
        videojs: "/api/res/icon/btn-player-videojs.svg"
    };

    const playerKindLabels = {
        native: "当前：浏览器原生播放器（点击切换为 videojs）",
        videojs: "当前：videojs 播放器（点击切换为浏览器原生）"
    };

    const playerKindAlts = {
        native: "浏览器原生播放器",
        videojs: "videojs 播放器"
    };

    const storageKeys = {
        lightMode: "lightMode",
        legacyLightMode: "liteplay.lightMode",
        playMode: "liteplay.playMode"
    };

    function readLocalStorageValue(key) {
        try {
            return window.localStorage.getItem(key);
        } catch {
            return null;
        }
    }

    function writeLocalStorageValue(key, value) {
        try {
            window.localStorage.setItem(key, value);
        } catch {
        }
    }

    const useNativeMobilePlayer = document.documentElement.classList.contains("native-mobile-player");
    if (useNativeMobilePlayer && elements.video) {
        elements.video.controls = true;
        elements.video.setAttribute("controls", "controls");
    }

    function detectIsMobileUserAgent() {
        const ua = navigator.userAgent || "";
        if (/Android|iPhone|iPad|iPod|IEMobile|BlackBerry|Opera Mini|Opera Mobi|Windows Phone|KaiOS|Mobile Safari/i.test(ua)) {
            return true;
        }
        if (/Macintosh/.test(ua) && (navigator.maxTouchPoints || 0) > 1) {
            return true;
        }
        return false;
    }

    let currentPlayerKind = (document.documentElement.dataset.playerKind === "native" || document.documentElement.dataset.playerKind === "videojs")
        ? document.documentElement.dataset.playerKind
        : (detectIsMobileUserAgent() ? "native" : "videojs");

    function getCurrentPlayerKind() {
        return currentPlayerKind;
    }

    function syncPlayerKindUi() {
        if (!elements.playerKindBtn || !elements.playerKindIcon) {
            return;
        }
        const kind = getCurrentPlayerKind();
        elements.playerKindIcon.src = playerKindIconUrls[kind];
        elements.playerKindIcon.alt = playerKindAlts[kind];
        elements.playerKindBtn.title = playerKindLabels[kind];
        elements.playerKindBtn.setAttribute("aria-label", playerKindLabels[kind]);
    }

    function ensureVideojsModuleLoaded() {
        if (document.documentElement.dataset.videojsLoaded === "1") {
            return;
        }
        document.documentElement.dataset.videojsLoaded = "1";
        const moduleScript = document.createElement("script");
        moduleScript.type = "module";
        moduleScript.src = "/api/res/lib/js/videojs/video-ui.js";
        document.head.append(moduleScript);
    }

    function applyPlayerKind(kind) {
        const previousTime = Number.isFinite(elements.video.currentTime) ? elements.video.currentTime : 0;
        const wasPaused = elements.video.paused;

        document.documentElement.dataset.playerKind = kind;

        if (kind === "native") {
            document.documentElement.classList.add("native-mobile-player");
            elements.video.controls = true;
            elements.video.setAttribute("controls", "controls");
        } else {
            document.documentElement.classList.remove("native-mobile-player");
            elements.video.controls = false;
            elements.video.removeAttribute("controls");
            ensureVideojsModuleLoaded();
        }

        // 切换内核后保持播放进度与播放/暂停状态。
        if (previousTime > 0) {
            try {
                elements.video.currentTime = previousTime;
            } catch {
            }
        }
        if (!wasPaused) {
            elements.video.play().catch(() => {
            });
        }
    }

    function togglePlayerKind() {
        if (elements.playerKindBtn?.disabled) {
            return;
        }
        if (elements.playerKindBtn) {
            elements.playerKindBtn.disabled = true;
        }
        const next = currentPlayerKind === "native" ? "videojs" : "native";
        currentPlayerKind = next;
        applyPlayerKind(next);
        syncPlayerKindUi();
        requestAnimationFrame(() => {
            if (elements.playerKindBtn) {
                elements.playerKindBtn.disabled = false;
            }
        });
    }

    function syncLightToggleUi() {
        if (!elements.lightToggleBtn) {
            return;
        }

        const isLightOff = document.body.classList.contains("is-light-off");
        elements.lightToggleBtn.dataset.light = isLightOff ? "off" : "on";
        elements.lightToggleBtn.setAttribute("aria-pressed", isLightOff ? "true" : "false");
        elements.lightToggleBtn.setAttribute("aria-label", isLightOff ? "开灯" : "关灯");
    }

    function toggleLightMask() {
        document.body.classList.toggle("is-light-off");
        const lightMode = document.body.classList.contains("is-light-off") ? "off" : "on";
        writeLocalStorageValue(storageKeys.lightMode, lightMode);
        syncLightToggleUi();
    }

    const playModeTips = {
        sequence: "当前模式：顺序播放",
        shuffle: "当前模式：随机播放",
        repeat: "当前模式：循环播放"
    };

    const modeCycle = ["sequence", "shuffle", "repeat"];

    let allVideos = [];
    let playlist = [];
    let currentIndex = -1;
    let currentPlayMode = "@Model.InitialPlayMode".toLowerCase();

    // ========================================
    // 播放控制模块
    // ========================================

    function isRepeatMode() {
        return currentPlayMode === "repeat";
    }

    function syncPlaybackModeUi() {
        elements.video.loop = isRepeatMode();
        elements.playModeBtn.title = playModeTips[currentPlayMode] || "播放模式切换";
        elements.playModeBtn.setAttribute("aria-label", playModeTips[currentPlayMode] || "播放模式切换");
        elements.playModeIcon.src = iconUrls[currentPlayMode] || iconUrls.sequence;
        elements.playModeIcon.alt = playModeTips[currentPlayMode] || "播放模式";
    }

    function cyclePlayMode() {
        const currentIndexInCycle = modeCycle.indexOf(currentPlayMode);
        const nextIndex = (currentIndexInCycle + 1) % modeCycle.length;
        const nextMode = modeCycle[nextIndex];
        const previousMode = currentPlayMode;
        currentPlayMode = nextMode;
        writeLocalStorageValue(storageKeys.playMode, currentPlayMode);
        syncPlaybackModeUi();

        if (nextMode === "shuffle" && previousMode !== "shuffle") {
            randomizePlaylist();
            return;
        }

        if (nextMode === "sequence" && previousMode !== "sequence") {
            restoreSequenceOrder();
        }
    }

    function restoreLightModeFromStorage() {
        const storedLightMode = (readLocalStorageValue(storageKeys.lightMode)
            || readLocalStorageValue(storageKeys.legacyLightMode)
            || "").toLowerCase();
        if (storedLightMode === "off") {
            document.body.classList.add("is-light-off");
            return;
        }

        if (storedLightMode === "on") {
            document.body.classList.remove("is-light-off");
        }
    }

    function restorePlayModeFromStorage() {
        const storedPlayMode = (readLocalStorageValue(storageKeys.playMode) || "").toLowerCase();
        if (modeCycle.includes(storedPlayMode)) {
            currentPlayMode = storedPlayMode;
        }
    }

    function compareByOriginalOrder(left, right) {
        const leftOrder = Number.isFinite(left.order) ? left.order : Number.MAX_SAFE_INTEGER;
        const rightOrder = Number.isFinite(right.order) ? right.order : Number.MAX_SAFE_INTEGER;

        if (leftOrder !== rightOrder) {
            return leftOrder - rightOrder;
        }

        const leftPath = left.relativePath || left.name || "";
        const rightPath = right.relativePath || right.name || "";
        return leftPath.localeCompare(rightPath, "zh-CN", {numeric: true, sensitivity: "base"});
    }

    function restoreSequenceOrder() {
        if (!playlist.length) {
            return;
        }

        const currentItem = currentIndex >= 0 ? playlist[currentIndex] : null;
        playlist.sort(compareByOriginalOrder);

        if (currentItem) {
            const restoredIndex = playlist.findIndex(item => item.url === currentItem.url);
            currentIndex = restoredIndex >= 0 ? restoredIndex : 0;
        }

        renderPlayerState();
    }

    function randomizePlaylist() {
        if (!playlist.length) {
            return;
        }

        shuffleInPlace(playlist);
        playAt(0, false);
    }

    function shuffleInPlace(items) {
        for (let index = items.length - 1; index > 0; index -= 1) {
            const swapIndex = Math.floor(Math.random() * (index + 1));
            const current = items[index];
            items[index] = items[swapIndex];
            items[swapIndex] = current;
        }
    }

    function stopPlayback() {
        elements.video.pause();
        elements.video.removeAttribute("src");
        elements.video.load();
    }

    // ========================================
    // 视频过滤和应用
    // ========================================

    function normalizeVideo(raw) {
        return {
            order: Number(raw.Order ?? raw.order ?? Number.MAX_SAFE_INTEGER),
            name: raw.Name || raw.name || "",
            relativePath: raw.RelativePath || raw.relativePath || "",
            extension: (raw.Extension || raw.extension || "").toLowerCase(),
            sizeBytes: Number(raw.SizeBytes || raw.sizeBytes || 0),
            url: raw.Url || raw.url || "",
            durationSeconds: raw.DurationSeconds != null
                ? Number(raw.DurationSeconds)
                : raw.durationSeconds == null
                    ? null
                    : Number(raw.durationSeconds)
        };
    }

    function buildFilterFunction(script) {
        return new Function("video", normalizeFilterScriptBody(script));
    }

    function applyScript() {
        if (!allVideos.length) {
            showEmptyState();
            return;
        }

        let predicate;
        try {
            predicate = buildFilterFunction(elements.scriptInput.value);
        } catch (error) {
            console.error("脚本编译错误：", error);
            return;
        }

        const filtered = [];
        for (const video of allVideos) {
            try {
                if (predicate(video)) {
                    filtered.push(video);
                }
            } catch (error) {
                console.error("脚本运行错误：", error);
                return;
            }
        }

        playlist = filtered.slice();
        if (currentPlayMode === "shuffle") {
            shuffleInPlace(playlist);
        }
        playAt(0, false);
    }

    async function loadVideoSummaries() {
        try {
            const endpoint = pathBase64
                ? `/api/ex/videoListApi/${locationBase64}/${pathBase64}`
                : `/api/ex/videoListApi/${locationBase64}`;
            const response = await fetch(endpoint, {method: "GET"});
            const payload = await response.json().catch(() => ({}));

            if (!response.ok) {
                return;
            }

            allVideos = Array.isArray(payload.videos) ? payload.videos.map(normalizeVideo) : [];
            if (!allVideos.length) {
                showEmptyState();
                return;
            }

            applyScript();
        } catch {
        }
    }

    // ========================================
    // UI 更新模块
    // ========================================

    function formatDuration(totalSeconds) {
        if (!Number.isFinite(totalSeconds) || totalSeconds <= 0) {
            return "--:--";
        }

        const roundedSeconds = Math.round(totalSeconds);
        const seconds = roundedSeconds % 60;
        const totalMinutes = Math.floor(roundedSeconds / 60);
        const minutes = totalMinutes % 60;
        const hours = Math.floor(totalMinutes / 60);

        if (hours > 0) {
            return `${hours}:${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
        }

        return `${String(minutes).padStart(2, "0")}:${String(seconds).padStart(2, "0")}`;
    }

    function formatBytes(totalBytes) {
        if (!Number.isFinite(totalBytes) || totalBytes <= 0) {
            return "--";
        }

        const units = ["B", "KB", "MB", "GB", "TB"];
        let size = totalBytes;
        let unitIndex = 0;

        while (size >= 1024 && unitIndex < units.length - 1) {
            size /= 1024;
            unitIndex += 1;
        }

        const digits = size >= 100 || unitIndex === 0 ? 0 : size >= 10 ? 1 : 2;
        return `${size.toFixed(digits)} ${units[unitIndex]}`;
    }

    function updateCounterText() {
        const current = currentIndex >= 0 ? currentIndex + 1 : 0;
        elements.counterText.textContent = `${current} / ${playlist.length}`;
    }

    function updateCurrentText() {
        const item = playlist[currentIndex];
        if (!item) {
            elements.currentText.textContent = "未选择视频";
            elements.currentPathText.textContent = "等待加载播放列表";
            elements.currentExtText.textContent = "--";
            elements.currentSizeText.textContent = "--";
            return;
        }

        const name = item.name || item.relativePath.split(/[\\\/]/).pop() || "未命名视频";
        const path = item.relativePath || name;
        const extension = item.extension || (name.includes(".") ? name.slice(name.lastIndexOf(".")).toLowerCase() : "--");

        elements.currentText.textContent = name;
        elements.currentPathText.textContent = path;
        elements.currentExtText.textContent = extension;
        elements.currentSizeText.textContent = formatBytes(item.sizeBytes);
    }

    function updateDurationText() {
        // Duration display removed; keeping function for compatibility
    }

    function syncPlayerFrameAspectRatio() {
        if (!elements.playerFrame) {
            return;
        }

        const videoWidth = elements.video.videoWidth;
        const videoHeight = elements.video.videoHeight;
        if (videoWidth > 0 && videoHeight > 0) {
            elements.playerFrame.style.aspectRatio = `${videoWidth} / ${videoHeight}`;
        }
    }

    function renderQueuePreview() {
        const previousScrollTop = elements.queueList.scrollTop;
        elements.queueList.textContent = "";

        if (!playlist.length) {
            return;
        }

        for (let index = 0; index < playlist.length; index += 1) {
            const item = playlist[index];
            const entry = document.createElement("li");
            entry.className = `queue-item${index === currentIndex ? " queue-item--active" : ""}`;
            entry.setAttribute("data-index", String(index));

            const name = document.createElement("div");
            name.className = "queue-name";
            name.textContent = item.name || item.relativePath || "未命名视频";

            const path = document.createElement("div");
            path.className = "queue-path";
            path.textContent = item.relativePath || "当前目录中的文件";

            entry.append(name, path);
            entry.addEventListener("click", () => playAt(index, true));
            elements.queueList.append(entry);
        }

        elements.queueList.scrollTop = previousScrollTop;
    }

    function renderPlayerState() {
        updateCounterText();
        updateCurrentText();
        updateDurationText();
        renderQueuePreview();
    }

    function showEmptyState() {
        currentIndex = -1;
        stopPlayback();
        renderPlayerState();
    }

    // ========================================
    // 播放管理和事件监听
    // ========================================

    function playAt(index, shouldAutoPlay) {
        if (!playlist.length) {
            showEmptyState();
            return;
        }

        if (index < 0) {
            index = playlist.length - 1;
        }
        if (index >= playlist.length) {
            index = 0;
        }

        const item = playlist[index];
        if (!item || !item.url) {
            return;
        }

        currentIndex = index;
        elements.video.loop = isRepeatMode();
        elements.video.src = item.url;
        elements.video.load();
        renderPlayerState();

        if (shouldAutoPlay) {
            elements.video.play().catch(() => {
            });
        }
    }

    elements.video.addEventListener("loadedmetadata", () => {
        updateDurationText();
        syncPlayerFrameAspectRatio();
    });
    elements.video.addEventListener("durationchange", () => {
        updateDurationText();
    });
    elements.video.addEventListener("error", () => {
    });
    elements.video.addEventListener("ended", () => {
        if (isRepeatMode()) {
            return;
        }

        playAt(currentIndex + 1, true);
    });

    elements.playModeBtn.addEventListener("click", () => {
        cyclePlayMode();
    });

    elements.prevBtn.addEventListener("click", () => playAt(currentIndex - 1, true));
    elements.nextBtn.addEventListener("click", () => playAt(currentIndex + 1, true));

    elements.applyScriptBtn.addEventListener("click", () => {
        applyScript();
    });
    elements.lightToggleBtn?.addEventListener("click", toggleLightMask);
    elements.playerKindBtn?.addEventListener("click", togglePlayerKind);

    // 初始化
    appendFilterScriptOptions();
    restoreLightModeFromStorage();
    restorePlayModeFromStorage();
    syncLightToggleUi();
    syncPlaybackModeUi();
    syncPlayerKindUi();
    renderPlayerState();
    loadVideoSummaries();
</script>

<script>
    async function loadBackgroundImage(windowWhRate) {
        let imageType;
        if (windowWhRate > 1) {
            imageType = "horizontal";
        } else {
            imageType = "vertical";
        }

        const url = `/api/bg?imageType=${imageType}`;
        const response = await fetch(url, {method: "GET"});
        if (!response.ok) {
            return null;
        }

        const blob = await response.blob();
        return URL.createObjectURL(blob);
    }

    let windowWhRate = window.innerWidth / window.innerHeight;
    let bgUrl = null;

    async function setBackground() {
        const previousRate = windowWhRate;
        windowWhRate = window.innerWidth / window.innerHeight;

        if (bgUrl === null || (previousRate > 1 && windowWhRate <= 1) || (previousRate <= 1 && windowWhRate > 1)) {
            bgUrl = await loadBackgroundImage(windowWhRate);
        }

        const htmlElement = document.documentElement;
        if (bgUrl === null) {
            htmlElement.style.setProperty("--html-bg-image", "none");
            htmlElement.style.setProperty("--front-bg-image", "none");
            return;
        }

        const img = new Image();
        img.src = bgUrl;
        await img.decode();
        const imgWhRate = img.width / img.height;

        htmlElement.style.setProperty("--html-bg-image", `url("${bgUrl}")`);
        htmlElement.style.setProperty("--html-bg-size", "cover");
        if ((windowWhRate > imgWhRate && windowWhRate > 1.7) || (windowWhRate < imgWhRate && windowWhRate < 0.3)) {
            htmlElement.style.setProperty("--html-bg-filter", "blur(4.8px) brightness(0.45)");
            htmlElement.style.setProperty("--front-bg-image", `url("${bgUrl}")`);
            htmlElement.style.setProperty("--front-bg-size", "contain");
        } else {
            htmlElement.style.setProperty("--html-bg-filter", "none");
            htmlElement.style.setProperty("--front-bg-image", "none");
            htmlElement.style.setProperty("--front-bg-size", "cover");
        }
    }

    window.addEventListener("resize", setBackground);
    setBackground();
</script>
</body>

</html>