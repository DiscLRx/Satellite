    </style>
    <script>
        (function () {
            const mobileUaPattern = /Android|iPhone|iPad|iPod|IEMobile|BlackBerry|Opera Mini|Opera Mobi|Windows Phone|KaiOS|Mobile Safari/i;

            function detectIsMobileUserAgent() {
                const ua = navigator.userAgent || "";
                if (mobileUaPattern.test(ua)) {
                    return true;
                }
                // iPadOS 13+ 在 Safari 中默认伪装为 Macintosh，需结合触屏点数判定。
                if (/Macintosh/.test(ua) && (navigator.maxTouchPoints || 0) > 1) {
                    return true;
                }
                return false;
            }

            const playerKind = detectIsMobileUserAgent() ? "native" : "videojs";
            document.documentElement.dataset.playerKind = playerKind;

            if (playerKind === "native") {
                document.documentElement.classList.add("native-mobile-player");
                return;
            }

            document.documentElement.dataset.videojsLoaded = "1";
            const moduleScript = document.createElement("script");
            moduleScript.type = "module";
            moduleScript.src = "/api/res/lib/js/videojs/video-ui.js";
            document.head.append(moduleScript);
        })();
    </script>
