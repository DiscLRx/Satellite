@page "/ex/lite-play/{locationNameBase64}/{relativePathBase64?}"
@model Server.Pages.ExtraFunctionPages.LitePlayPage

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8"/>
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover"/>
    <meta name="format-detection" content="telephone=no,email=no,address=no"/>
    <title>LITE PLAY</title>
    @await Html.PartialAsync("/Pages/Shared/_SatelliteTheme.cshtml")
    <link rel="stylesheet" href="/api/res/lib/css/videojs/video-player.css"/>
    <style>
        :root {
            --card-blur: calc(var(--glass-blur) + 8.8px);
            --btn-bg: rgba(255, 138, 61, 0.08);
            --btn-bg-hover: rgba(255, 138, 61, 0.14);
            --btn-border: rgba(255, 138, 61, 0.34);
            --btn-border-hover: rgba(255, 138, 61, 0.52);
            --body-overlay: rgba(6, 10, 16, 0);
            --body-overlay-strong: rgba(6, 10, 16, 0.84);
            --card-radius: 15px;
            --radius-xl: 28px;
            --radius-lg: 20px;
            --radius-md: 14px;
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            width: 100%;
            min-height: 100%;
            height: 100%;
            background: var(--bg);
            color: var(--text);
            overflow-x: hidden;
        }

        html::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: var(--html-bg-image, none);
            background-position: center center;
            background-size: var(--html-bg-size, cover);
            background-repeat: no-repeat;
            background-attachment: fixed;
            filter: var(--html-bg-filter, none);
            transform: scale(1.04);
            z-index: -2;
            pointer-events: none;
        }

        html::after {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-image: var(--front-bg-image, none);
            background-position: center center;
            background-size: var(--front-bg-size, contain);
            background-repeat: no-repeat;
            pointer-events: none;
            z-index: -1;
        }

        body {
            font-family: "Bahnschrift", "Segoe UI", sans-serif;
            background-color: var(--body-overlay);
            padding: 20px;
            transition: background-color 0.22s ease;
        }

        body.is-light-off {
            background-color: var(--body-overlay-strong);
        }

        a,
        button,
        input,
        select,
        textarea {
            font: inherit;
        }

        button,
        select,
        textarea,
        input {
            color: inherit;
        }

        .page {
            width: min(1360px, 100%);
            margin: 0 auto;
            min-height: calc(100vh - 40px);
            display: grid;
            gap: 18px;
            align-content: start;
            overflow: visible;
        }

        .surface {
            background: var(--panel);
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            box-shadow: var(--shadow);
            backdrop-filter: blur(var(--card-blur)) saturate(118%);
            -webkit-backdrop-filter: blur(var(--card-blur)) saturate(118%);
            min-width: 0;
        }

        .hero {
            padding: 14px 18px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
        }

        .hero-actions {
            display: flex;
            align-items: center;
            gap: 10px;
            flex-wrap: nowrap;
            justify-content: flex-end;
        }

        .eyebrow {
            margin: 0;
            color: var(--accent-strong);
            font-size: 0.72rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
        }

        .hero-heading {
            display: grid;
            gap: 6px;
        }

        .hero-title {
            margin: 0;
            font-size: clamp(0.98rem, 1.75vw, 1.26rem);
            line-height: 1.1;
            letter-spacing: 0.05em;
            text-transform: uppercase;
        }

        .back-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 46px;
            padding: 0 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--btn-border);
            text-decoration: none;
            color: var(--text);
            background: var(--btn-bg);
            white-space: nowrap;
            transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
        }

        .back-link:hover,
        .back-link:focus-visible {
            outline: none;
            border-color: var(--btn-border-hover);
            background: var(--btn-bg-hover);
            transform: translateY(-1px);
        }

        .light-toggle-btn {
            cursor: pointer;
            width: 46px;
            min-width: 46px;
            max-width: 46px;
            height: 46px;
            min-height: 46px;
            max-height: 46px;
            padding: 0;
        }

        .light-toggle-btn .icon-light-on,
        .light-toggle-btn .icon-light-off {
            display: none;
            width: 22px;
            height: 22px;
        }

        .light-toggle-btn[data-light="off"] .icon-light-off {
            display: block;
        }

        .light-toggle-btn[data-light="on"] .icon-light-on {
            display: block;
        }

        .workspace {
            display: grid;
            grid-template-columns: minmax(0, 1.5fr) minmax(320px, 0.85fr);
            gap: 18px;
            align-items: start;
            min-width: 0;
        }

        .equal-height-card {
            min-height: 420px;
        }

        .script-card {
            display: flex;
            flex-direction: column;
        }

        .script-card .field--script {
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
        }

        .script-card .textarea {
            flex: 1;
            min-height: 0;
        }

        .queue-card {
            min-height: 430px;
        }

        .player-panel,
        .sidebar {
            display: grid;
            gap: 18px;
            min-width: 0;
        }

        .block {
            padding: 18px;
        }

        .player-frame-wrap {
            padding: 0;
        }

        .player-frame {
            width: 100%;
            aspect-ratio: 16 / 9;
            min-height: 0;
            border-radius: var(--card-radius);
            overflow: hidden;
            background: #000;
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.04);
        }

        .player-frame video-player {
            display: block;
            width: 100%;
            height: 100%;
            --media-border-radius: var(--card-radius);
            --media-video-border-radius: var(--card-radius);
            --media-surface-background-color: oklch(0.14 0 0 / 0.88);
            --media-surface-inner-border-color: oklch(1 0 0 / 0.08);
            --media-surface-outer-border-color: oklch(1 0 0 / 0.12);
            --media-surface-shadow-color: oklch(0 0 0 / 0.4);
            --media-surface-shadow: 0 0 24px oklch(0 0 0 / 0.36);
        }

        .player-frame .media-surface {
            box-shadow: 0 0 24px oklch(0 0 0 / 0.36) !important;
        }

        .player-frame video-player,
        .player-frame video-player *,
        .player-frame video,
        .player-frame .media-controls,
        .player-frame .media-overlay {
            cursor: default !important;
            user-select: none !important;
            -webkit-user-select: none !important;
        }

        .player-frame video {
            width: 100%;
            height: 100%;
            object-fit: contain;
            background: #000;
        }

        .player-frame media-container,
        .player-frame .media-provider {
            width: 100% !important;
            height: 100% !important;
        }

        /* Fix: volume slider needs explicit vertical dimensions independent of data-orientation */
        .player-frame media-volume-slider {
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
            width: 2rem !important;
            height: 5rem !important;
            position: relative !important;
        }

        .player-frame media-volume-slider .media-slider__track {
            width: 0.25rem !important;
            height: 100% !important;
            background-color: oklch(1 0 0 / 0.15) !important;
        }

        .player-frame media-volume-slider .media-slider__fill {
            inset-inline: 0 !important;
            bottom: 0 !important;
            height: var(--media-slider-fill, 0%) !important;
        }

        .player-frame media-volume-slider .media-slider__thumb {
            left: 50% !important;
            top: calc(100% - var(--media-slider-fill, 0%)) !important;
            opacity: 1 !important;
        }

        .toolbar-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
            align-items: center;
            width: 100%;
        }

        .action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            height: 46px;
            padding: 0 16px;
            border-radius: var(--radius-md);
            border: 1px solid var(--btn-border);
            background: var(--btn-bg);
            cursor: pointer;
            line-height: 1;
            text-align: center;
            transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
        }

        .action:hover,
        .action:focus-visible {
            outline: none;
            border-color: var(--btn-border-hover);
            background: var(--btn-bg-hover);
            transform: translateY(-1px);
        }

        .action--primary {
            border-color: var(--btn-border);
            background: var(--btn-bg);
        }

        .action--primary:hover,
        .action--primary:focus-visible {
            border-color: var(--btn-border-hover);
            background: var(--btn-bg-hover);
        }

        .action--icon {
            width: 46px;
            padding: 0;
        }

        .mode-icon {
            width: 22px;
            height: 22px;
            display: block;
        }


        .panel-title {
            margin: 0 0 14px;
            font-size: 1rem;
            line-height: 1;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .panel-title .script-notice {
            position: static;
            transform: none;
            min-width: 0;
            max-width: none;
            height: 30px;
            font-size: 12px;
            font-weight: normal;
            padding: 0 12px;
            line-height: 30px;
            border-radius: 6px;
            border: 1px solid rgba(94, 170, 196, 0.62);
            background: rgba(78, 156, 184, 0.18);
            color: rgba(221, 245, 252, 0.96);
            box-shadow: none;
            box-sizing: border-box;
            white-space: nowrap;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.18s ease, visibility 0s linear 0.18s;
        }

        .panel-title .script-notice.is-visible {
            transform: none;
            opacity: 1;
            visibility: visible;
            transition: opacity 0.18s ease, visibility 0s;
        }

        .field {
            display: grid;
            gap: 8px;
        }

        .field-label {
            color: var(--text-muted);
            font-size: 0.82rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        .metrics-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 10px;
        }

        .metric-card {
            border: 1px solid var(--line);
            border-radius: var(--card-radius);
            background: rgba(255, 255, 255, 0.18);
            padding: 12px;
            display: grid;
            gap: 6px;
        }

        .metric-card--wide {
            grid-column: 1 / -1;
        }

        .metric-controls-row {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 10px;
            grid-column: 1 / -1;
        }

        .metric-controls-row .action,
        .metric-controls-row .action--icon {
            width: 100%;
            max-width: none;
        }

        .metric-value {
            font-size: 0.98rem;
            line-height: 1.35;
            word-break: break-word;
        }

        .metric-subtext {
            color: var(--text-muted);
            font-size: 0.85rem;
            line-height: 1.35;
            word-break: break-word;
        }

        .metric-subtext--value-tone {
            color: var(--text);
        }

        .visually-hidden {
            position: absolute !important;
            width: 1px;
            height: 1px;
            padding: 0;
            margin: -1px;
            overflow: hidden;
            clip: rect(0, 0, 0, 0);
            white-space: nowrap;
            border: 0;
        }

        .select,
        .textarea {
            width: 100%;
            border-radius: var(--radius-md);
            border: 1px solid var(--line);
            background: var(--panel-strong);
            color: var(--text);
        }

        .select {
            min-height: 48px;
            padding: 0 14px;
        }

        .script-select {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 1fr) 46px;
            gap: 8px;
            align-items: center;
        }

        .script-name-input {
            min-width: 0;
            transition: border-color 0.2s ease, background-color 0.2s ease, color 0.2s ease, box-shadow 0.2s ease;
        }

        .script-name-input[readonly] {
            cursor: default;
            background: rgba(36, 44, 56, 0.9);
            border-color: rgba(118, 145, 176, 0.34);
            color: #f2f6fb;
            box-shadow: 0 0 0 1px rgba(118, 145, 176, 0.08);
        }

        .script-name-input:not([readonly]) {
            background: rgba(24, 30, 40, 0.88);
            border-color: rgba(90, 108, 132, 0.22);
            color: rgba(214, 223, 233, 0.78);
            box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.015);
        }

        .script-name-input::placeholder {
            color: rgba(210, 221, 234, 0.52);
        }

        .select-trigger {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            border-radius: var(--radius-md);
            border: 1px solid var(--line);
            background: var(--panel-strong);
            color: var(--text);
            cursor: pointer;
            transition: border-color 0.2s ease, background-color 0.2s ease, transform 0.2s ease;
        }

        .select-trigger:hover,
        .select-trigger:focus-visible {
            outline: none;
            border-color: rgba(255, 138, 61, 0.45);
            background: rgba(255, 138, 61, 0.08);
            transform: translateY(-1px);
        }

        .select-arrow {
            width: 12px;
            height: 12px;
            border-right: 2px solid currentColor;
            border-bottom: 2px solid currentColor;
            transform: rotate(45deg) translateY(-1px);
            transition: transform 0.18s ease;
        }

        .script-select.open .select-arrow {
            transform: rotate(-135deg) translateY(-1px);
        }

        .select-menu {
            position: absolute;
            left: 0;
            top: calc(100% + 8px);
            margin: 0;
            padding: 6px;
            list-style: none;
            background: rgba(18, 24, 31, 0.62);
            border: 1px solid var(--line);
            border-radius: var(--radius-md);
            box-shadow: var(--shadow);
            backdrop-filter: blur(calc(var(--card-blur) + 4px)) saturate(125%);
            -webkit-backdrop-filter: blur(calc(var(--card-blur) + 4px)) saturate(125%);
            max-height: 240px;
            overflow-y: auto;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
            scrollbar-color: rgba(100, 100, 100, 0.35) transparent;
            z-index: 220;
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
            transform: translateY(6px) scale(0.98);
            transform-origin: top center;
        }

        .select-menu::-webkit-scrollbar {
            width: 8px;
        }

        .select-menu::-webkit-scrollbar-track {
            background: transparent;
        }

        .select-menu::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.35);
            border-radius: 4px;
            transition: background 0.2s ease;
        }

        .select-menu::-webkit-scrollbar-thumb:hover {
            background: rgba(130, 130, 130, 0.49);
        }

        .select-menu.select-menu--portal {
            position: fixed;
            left: var(--menu-left, 0px);
            top: var(--menu-top, 0px);
            width: var(--menu-width, 240px);
            right: auto;
            bottom: auto;
            transition: none;
            z-index: 999;
        }

        .select-menu.select-menu--portal.is-open {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateY(0) scale(1);
        }

        .select-option {
            width: 100%;
            border: 0;
            border-radius: 10px;
            background: transparent;
            color: var(--text);
            text-align: left;
            font-size: 0.92rem;
            padding: 9px 10px;
            cursor: pointer;
        }

        .select-option:hover,
        .select-option:focus-visible {
            outline: none;
            background: var(--btn-bg-hover);
            color: #ffffff;
        }

        .select-option.active {
            background: var(--btn-bg);
            color: #ffffff;
        }

        .textarea {
            min-height: 240px;
            resize: none;
            padding: 14px;
            font-size: 12px;
            line-height: 1.6;
            font-family: "IBM Plex Mono", "Cascadia Code", monospace;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
            scrollbar-color: rgba(100, 100, 100, 0.35) transparent;
        }

        .textarea::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .textarea::-webkit-scrollbar-track {
            background: transparent;
        }

        .textarea::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.35);
            border-radius: 4px;
            transition: background 0.2s ease;
        }

        .textarea::-webkit-scrollbar-thumb:hover {
            background: rgba(130, 130, 130, 0.49);
        }

        .select:focus,
        .textarea:focus {
            outline: none;
            border-color: rgba(255, 138, 61, 0.45);
            box-shadow: 0 0 0 4px rgba(255, 138, 61, 0.08);
        }

        .queue-list {
            margin: 0;
            padding: 0;
            list-style: none;
            display: grid;
            gap: 10px;
            max-height: 460px;
            overflow-y: auto;
            overflow-x: hidden;
            scrollbar-gutter: stable;
            scrollbar-width: thin;
            scrollbar-color: rgba(100, 100, 100, 0.35) transparent;
        }

        .queue-list::-webkit-scrollbar {
            width: 8px;
        }

        .queue-list::-webkit-scrollbar-track {
            background: transparent;
        }

        .queue-list::-webkit-scrollbar-thumb {
            background: rgba(100, 100, 100, 0.35);
            border-radius: 4px;
            transition: background 0.2s ease;
        }

        .queue-list::-webkit-scrollbar-thumb:hover {
            background: rgba(130, 130, 130, 0.49);
        }

        .queue-item {
            padding: 12px 14px;
            border-radius: var(--card-radius);
            border: 1px solid var(--line);
            background: rgba(255, 255, 255, 0.18);
            display: grid;
            gap: 6px;
            cursor: pointer;
            transition: border-color 150ms ease, background-color 150ms ease;
        }

        .queue-item:hover {
            border-color: var(--btn-border-hover);
            background: var(--btn-bg-hover);
        }

        .queue-item--active {
            border-color: var(--btn-border);
            background: var(--btn-bg);
        }

        .queue-name {
            font-size: 0.95rem;
            line-height: 1.35;
            word-break: break-word;
        }

        .queue-path {
            color: var(--text-muted);
            font-size: 0.84rem;
            line-height: 1.35;
            word-break: break-word;
        }

        .media-button--play .media-icon--restart,
        .media-button--play .media-icon--play,
        .media-button--play .media-icon--pause,
        .media-button--mute .media-icon--volume-high,
        .media-button--mute .media-icon--volume-low,
        .media-button--mute .media-icon--volume-off,
        .media-button--fullscreen .media-icon--fullscreen-enter,
        .media-button--fullscreen .media-icon--fullscreen-exit {
            width: 18px;
            height: 18px;
        }

        @@media (max-width: 1100px) {
            .workspace {
                grid-template-columns: 1fr;
            }
        }

        .native-mobile-player .player-frame media-controls,
        .native-mobile-player .player-frame media-overlay,
        .native-mobile-player .player-frame media-buffering-indicator,
        .native-mobile-player .player-frame media-error-dialog,
        .native-mobile-player .player-frame media-tooltip,
        .native-mobile-player .player-frame media-tooltip-group,
        .native-mobile-player .player-frame media-popover,
        .native-mobile-player .player-frame media-gesture,
        .native-mobile-player .player-frame media-hotkey {
            display: none !important;
        }

        @@media (max-width: 720px) {

            body {
                padding: 10px max(10px, env(safe-area-inset-right)) 10px max(10px, env(safe-area-inset-left));
            }

            .page {
                min-height: calc(100vh - 24px);
                gap: 12px;
            }

            .workspace,
            .player-panel,
            .sidebar {
                gap: 12px;
            }

            .block {
                padding: 12px;
            }

            .player-frame-wrap {
                padding: 0;
                border: none;
                box-shadow: none;
                background: transparent;
            }

            .hero {
                flex-direction: column;
                align-items: stretch;
                order: 10;
            }

            .workspace {
                order: 1;
            }

            .back-link {
                width: 100%;
                white-space: nowrap;
            }

            .hero-actions {
                width: 100%;
                justify-content: stretch;
            }

            .light-toggle-btn {
                width: 46px;
            }

            .player-frame {
                min-height: 0;
            }

            .player-frame video {
                object-fit: contain;
                background: #000;
            }

            .equal-height-card,
            .queue-card {
                min-height: 0;
            }

            .queue-list {
                max-height: 320px;
            }

            .toolbar-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
            }

            .save-action-wrap {
                width: 100%;
            }

            .select-menu.select-menu--portal {
                left: var(--menu-left, 10px);
                right: auto;
                top: var(--menu-top, 10px);
                bottom: auto;
                width: var(--menu-width, calc(100vw - 20px));
                max-height: min(50vh, 340px);
                border-radius: 18px;
                transform-origin: top center;
            }

            .action {
                width: 100%;
                max-width: none;
            }

            .metrics-grid {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .metrics-grid .metric-card {
                padding: 10px;
                border-radius: var(--card-radius);
                gap: 4px;
            }

            .metrics-grid .field-label {
                font-size: 0.7rem;
                letter-spacing: 0.05em;
            }

            .metrics-grid .metric-value {
                font-size: 0.9rem;
                line-height: 1.28;
            }

            .metrics-grid .metric-subtext {
                font-size: 0.78rem;
                line-height: 1.28;
            }

            .metric-controls-row {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }

            .player-frame media-mute-button,
            .player-frame .media-popover--volume,
            .player-frame #video-volume-popover {
                display: none !important;
            }

            .sidebar .queue-card {
