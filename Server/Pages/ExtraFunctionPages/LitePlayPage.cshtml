        nextBtn: document.getElementById("nextBtn"),
        counterText: document.getElementById("counterText"),
        currentText: document.getElementById("currentText"),
        currentPathText: document.getElementById("currentPathText"),
        currentExtText: document.getElementById("currentExtText"),
        currentSizeText: document.getElementById("currentSizeText"),
        queueList: document.getElementById("queueList")
    };
</script>
<script>
    // 筛选脚本管理

    let scriptNoticeTimerId = null;

    function showScriptNotice(message) {
        if (!elements.scriptNotice) {
            return;
        }

        if (scriptNoticeTimerId) {
            clearTimeout(scriptNoticeTimerId);
        }

        elements.scriptNotice.textContent = message;
        elements.scriptNotice.classList.add("is-visible");

        scriptNoticeTimerId = setTimeout(() => {
            elements.scriptNotice.classList.remove("is-visible");
            scriptNoticeTimerId = null;
        }, 2000);
    }

    const presetScripts = {
        "All videos": {
            isPreset: true,
            script: "return true;"
        },
        "MP4 only": {
            isPreset: true,
            script: "return video.extension === '.mp4';"
        },
        "Large files (> 300MB)": {
            isPreset: true,
            script: "return video.sizeBytes > 300 * 1024 * 1024;"
        },
        "Long videos (> 15 min)": {
            isPreset: true,
            script: "return (video.durationSeconds || 0) > 15 * 60;"
        }
    };

    const savedScripts = @Html.Raw(Model.LocationVideoFilterScriptsJson);

    const filterScripts = {};
    for (const [name, scriptInfo] of Object.entries(presetScripts)) {
        filterScripts[name] = scriptInfo;
    }
    for (const [name, script] of Object.entries(savedScripts)) {
        filterScripts[name] = {
            isPreset: false,
            script
        };
    }

    function mergeServerScriptsIntoFilterScripts(serverScripts) {
        for (const scriptName of Object.keys(filterScripts)) {
            delete filterScripts[scriptName];
        }

        for (const [name, scriptInfo] of Object.entries(presetScripts)) {
            filterScripts[name] = scriptInfo;
        }

        if (!serverScripts || typeof serverScripts !== "object") {
            return;
        }

        for (const [name, script] of Object.entries(serverScripts)) {
            filterScripts[name] = {
                isPreset: false,
                script: String(script ?? "")
            };
        }
    }

    let currentScriptName = Object.keys(filterScripts)[0] || "";
    let isEditingNewScript = false;

    function appendFilterScriptOptions() {
        if (!elements.scriptMenu) {
            return;
        }

        elements.scriptMenu.textContent = "";

        for (const scriptName of Object.keys(filterScripts)) {
            const item = document.createElement("li");
            const button = document.createElement("button");
            const isActive = scriptName === currentScriptName;

            button.type = "button";
            button.className = `select-option${isActive ? " active" : ""}`;
            button.setAttribute("role", "option");
            button.setAttribute("aria-selected", String(isActive));
            button.dataset.scriptName = scriptName;
            button.textContent = scriptName;

            item.append(button);
            elements.scriptMenu.append(item);
        }
    }

    function selectFilterScript(scriptName) {
        if (!scriptName || !filterScripts[scriptName]) {
            return;
        }
        isEditingNewScript = false;
        const scriptKeys = Object.keys(filterScripts);
        if (!scriptKeys.includes(scriptName)) {
            scriptName = scriptKeys[0];
        } 

        currentScriptName = scriptName;
        const scriptInfo = filterScripts[scriptName];
        elements.scriptNameInput.value = scriptName;
        elements.scriptInput.value = scriptInfo.script;

        elements.scriptNameInput.readOnly = true;
        elements.scriptInput.readOnly = scriptInfo.isPreset;
        elements.saveScriptBtn.disabled = scriptInfo.isPreset;
        elements.formatScriptBtn.disabled = scriptInfo.isPreset;

        appendFilterScriptOptions();
    }

    function isScriptMenuOpen() {
        return elements.scriptMenu?.classList.contains("is-open") || false;
    }

    function ensureScriptMenuPortal() {
        if (!elements.scriptMenu) {
            return;
        }

        if (elements.scriptMenu.parentElement !== document.body) {
            document.body.append(elements.scriptMenu);
        }

        elements.scriptMenu.classList.add("select-menu--portal");
    }

    function positionScriptMenu() {
        if (!elements.scriptMenu || !elements.scriptMenuTrigger) {
            return;
        }

        const isMobileViewport = window.matchMedia("(max-width: 720px)").matches
            || document.documentElement.classList.contains("native-mobile-player");

        // position: fixed uses viewport coordinates; getBoundingClientRect keeps alignment correct while scrolling.
        const inputRect = elements.scriptNameInput.getBoundingClientRect();
        const viewportWidth = document.documentElement.clientWidth;
        const minInset = isMobileViewport ? 10 : 8;

        let width = inputRect.width;
        if (!Number.isFinite(width) || width <= 0) {
            width = elements.scriptNameInput.offsetWidth || 220;
        }

        let left = inputRect.left;
        let right = left + width;

        if (left < minInset) {
            left = minInset;
            right = left + width;
        }

        if (right > viewportWidth - minInset) {
            const maxWidth = Math.max(220, viewportWidth - minInset * 2);
            width = Math.min(width, maxWidth);
            left = Math.max(minInset, viewportWidth - minInset - width);
        }

        const top = inputRect.bottom;

        elements.scriptMenu.style.setProperty("--menu-left", `${Math.round(left)}px`);
        elements.scriptMenu.style.setProperty("--menu-top", `${Math.round(top)}px`);
        elements.scriptMenu.style.setProperty("--menu-width", `${Math.round(width)}px`);
    }

    function openScriptMenu() {
        ensureScriptMenuPortal();
        positionScriptMenu();
        elements.scriptSelect?.classList.add("open");
        elements.scriptMenu?.classList.add("is-open");
        elements.scriptMenuTrigger?.setAttribute("aria-expanded", "true");

        const activeOption = elements.scriptMenu?.querySelector(".select-option.active")
            || elements.scriptMenu?.querySelector(".select-option");
        activeOption?.focus();
    }

    function closeScriptMenu() {
        elements.scriptSelect?.classList.remove("open");
        elements.scriptMenu?.classList.remove("is-open");
        elements.scriptMenuTrigger?.setAttribute("aria-expanded", "false");
    }

    function toggleScriptMenu() {
        if (isScriptMenuOpen()) {
            closeScriptMenu();
            return;
        }

        openScriptMenu();
    }

    // 下拉菜单项选择
    if (elements.scriptMenu) {
        elements.scriptMenu.addEventListener("click", (event) => {
            const button = event.target.closest("button.select-option");
            if (!button) {
                return;
            }

            const selectedScriptName = button.dataset.scriptName || button.textContent;
            selectFilterScript(selectedScriptName);
            closeScriptMenu();
        });
    }

    // 触发器交互
    elements.scriptMenuTrigger?.addEventListener("click", () => {
        toggleScriptMenu();
    });

    // 外部点击关闭
    document.addEventListener("click", (event) => {
        if (!isScriptMenuOpen()) {
            return;
        }

        const target = event.target;
        const isInsideTrigger = elements.scriptSelect?.contains(target);
        const isInsideMenu = elements.scriptMenu?.contains(target);
        if (isInsideTrigger || isInsideMenu) {
            return;
        }

        closeScriptMenu();
    });

    // 打开状态下保持定位
    window.addEventListener("resize", () => {
        if (isScriptMenuOpen()) {
            positionScriptMenu();
        }
    });

    window.addEventListener("scroll", () => {
        if (isScriptMenuOpen()) {
            positionScriptMenu();
        }
    }, true);

    appendFilterScriptOptions();
    if (currentScriptName) {
        selectFilterScript(currentScriptName);
    }

    // 格式化
    elements.formatScriptBtn?.addEventListener("click", () => {
        const rawScript = elements.scriptInput.value || "";
        const normalizedScript = normalizeFilterScriptBody(rawScript);

        try {
            const formatted = prettier.format(normalizedScript, {
                parser: "babel",
                plugins: prettierPlugins,
                singleQuote: true,
                trailingComma: "all",
                printWidth: 60
            }).trim();

            elements.scriptInput.value = formatted;
        } catch (error) {
            console.error("Failed to format script:", error);
            showScriptNotice("格式化失败，请检查脚本语法");
        }
    });

    //新建
    elements.newScriptBtn?.addEventListener("click", () => {
        isEditingNewScript = true;
        elements.scriptNameInput.value = "";
        elements.scriptInput.value = "";
        elements.scriptNameInput.readOnly = false;
        elements.scriptInput.readOnly = false;
        elements.saveScriptBtn.disabled = false;
        elements.formatScriptBtn.disabled = false;
        elements.scriptNameInput.focus();
    });

    // 保存
    elements.saveScriptBtn?.addEventListener("click", async () => {
        const name = elements.scriptNameInput.value.trim();
        const script = elements.scriptInput.value.trim();

        if (!name) {
            showScriptNotice("请为筛选脚本输入名称");
            return;
        }

        if (!script && isEditingNewScript) {
            showScriptNotice("请为筛选脚本输入 JavaScript 函数体");
            return;
        }


        if (Object.keys(filterScripts).includes(name) && isEditingNewScript) {
            const existing = filterScripts[name];
            if (existing.isPreset) {
                showScriptNotice("无法覆盖预设脚本，请使用其他名称");
                return;
            } else {
                showScriptNotice("已存在同名脚本，请使用其他名称");
                return;
            }
        }
        await fetch('/api/ex/videoFilterScript', {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                scriptName: name,
                scriptBody: script
            })
        }).then(async response => {
            if (!response.ok) {
                throw new Error();
            }

            const serverScripts = await response.json().catch(() => ({}));
            mergeServerScriptsIntoFilterScripts(serverScripts);
            isEditingNewScript = false;
            appendFilterScriptOptions();
            selectFilterScript(name);
            showScriptNotice("脚本保存成功");
        }).catch(_ => {
            showScriptNotice("脚本保存失败");
        });
    });
