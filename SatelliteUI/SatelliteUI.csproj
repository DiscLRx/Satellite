<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <LangVersion>14</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ApplicationIcon>Assets/satellite-logo.ico</ApplicationIcon>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <PropertyGroup>
        <CoreAppDataJsonPath>..\SatelliteCore\appdata.json</CoreAppDataJsonPath>
        <CoreCustomRoot>..\SatelliteCore\Custom</CoreCustomRoot>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="11.3.10" />
        <PackageReference Include="Avalonia.Controls.ItemsRepeater" Version="11.1.5" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.10" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.10" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.10" />
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.10">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.1" />
        <PackageReference Include="OpenCvSharp4" Version="4.11.0.20250507" />
        <PackageReference Include="OpenCvSharp4.Windows" Version="4.11.0.20250507" />
        <PackageReference Include="ReactiveUI.Avalonia" Version="11.3.8" />
        <PackageReference Include="Semi.Avalonia" Version="11.3.7.3" />
        <PackageReference Include="Tmds.DBus.Protocol" Version="0.92.0" />
        <PackageReference Include="Xaml.Behaviors.Avalonia" Version="11.3.9.5" />
        <PackageReference Include="Xaml.Behaviors.Interactions" Version="11.3.9.5" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SatelliteCore\SatelliteCore.csproj" />
        <ProjectReference Include="..\Data\Data.csproj" />
        <ProjectReference Include="..\Server\Server.csproj" />
    </ItemGroup>

    <Target Name="CopyCoreAppDataAfterBuild"
            AfterTargets="Build"
            Condition="Exists('$(CoreAppDataJsonPath)')">
        <Copy SourceFiles="$(CoreAppDataJsonPath)"
              DestinationFiles="$(TargetDir)appdata.json"
              SkipUnchangedFiles="false"
              OverwriteReadOnlyFiles="true" />
    </Target>

    <Target Name="CopyCoreAppDataAfterPublish"
            AfterTargets="Publish"
            Condition="Exists('$(CoreAppDataJsonPath)') and '$(PublishDir)' != ''">
        <Copy SourceFiles="$(CoreAppDataJsonPath)"
              DestinationFiles="$(PublishDir)appdata.json"
              SkipUnchangedFiles="false"
              OverwriteReadOnlyFiles="true" />
    </Target>

    <Target Name="CopyCustomAfterBuild"
            AfterTargets="Build"
            Condition="'$(TargetDir)' != ''">
        <ItemGroup>
            <_CoreCustomFiles Include="$(CoreCustomRoot)\**\*"
                              Condition="Exists('$(CoreCustomRoot)')" />
            <_UiCustomFiles Include="$(MSBuildProjectDirectory)\Custom\**\*"
                            Condition="Exists('$(MSBuildProjectDirectory)\Custom')" />
        </ItemGroup>
        <Copy SourceFiles="@(_CoreCustomFiles)"
              DestinationFiles="@(_CoreCustomFiles->'$(TargetDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_UiCustomFiles)"
              DestinationFiles="@(_UiCustomFiles->'$(TargetDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="CopyCustomAfterPublish"
            AfterTargets="Publish"
            Condition="'$(PublishDir)' != ''">
        <ItemGroup>
            <_CoreCustomFilesPublish Include="$(CoreCustomRoot)\**\*"
                                     Condition="Exists('$(CoreCustomRoot)')" />
            <_UiCustomFilesPublish Include="$(MSBuildProjectDirectory)\Custom\**\*"
                                   Condition="Exists('$(MSBuildProjectDirectory)\Custom')" />
        </ItemGroup>
        <Copy SourceFiles="@(_CoreCustomFilesPublish)"
              DestinationFiles="@(_CoreCustomFilesPublish->'$(PublishDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
        <Copy SourceFiles="@(_UiCustomFilesPublish)"
              DestinationFiles="@(_UiCustomFilesPublish->'$(PublishDir)Custom\%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

</Project>
