        </Style>
        <Style Selector="Button.location_control_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#cc000000" />
        </Style>
        <Style Selector="Button.location_control_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
