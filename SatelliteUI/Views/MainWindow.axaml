<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SatelliteUI.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:SatelliteUI.ViewModels.Converters"
        xmlns:service="clr-namespace:Data;assembly=Data"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="SatelliteUI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/satellite-logo.ico"
        Width="880"
        Height="560"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="40"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        x:Name="Root">
    <Window.Resources>
        <converters:PortButtonCheckedConverter x:Key="PortButtonCheckedConverter" />
        <converters:CurrentLocationsConverter x:Key="CurrentLocationsConverter" />
        <converters:IsNotNullConverter x:Key="IsNotNullConverter" />
        <converters:InstanceLockedConverter x:Key="InstanceLockedConverter" />
        <converters:BackgroundOpacityConverter x:Key="BackgroundOpacityConverter" />
        <converters:BackgroundBlurConverter x:Key="BackgroundBlurConverter" />
    </Window.Resources>

    <Window.Styles>

        <Style Selector="StackPanel.window_basics">
            <Setter Property="Width" Value="880" />
            <Setter Property="Height" Value="560" />
        </Style>
        <Style Selector="ExperimentalAcrylicBorder.acrylic_title_border">
            <Setter Property="Material">
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#000"
                    TintOpacity="1"
                    MaterialOpacity="0.5" />
            </Setter>
        </Style>
        <Style Selector="DockPanel.title_bar">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="880" />
        </Style>
        <Style Selector="DockPanel.title_bar_dockpanel">
            <Setter Property="Height" Value="40" />
            <Setter Property="Width" Value="880" />
            <Setter Property="Background" Value="#88000000" />

        </Style>
        <Style Selector="Button.title_button">
            <Setter Property="MinHeight" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,10,10,10" />

        </Style>

        <Style Selector="Button.close_button">
            <Setter Property="Background" Value="#f55" />
        </Style>
        <Style Selector="Button.close_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#c33" />
        </Style>
        <Style Selector="Button.minimization_button">
            <Setter Property="Background" Value="#fa0" />
        </Style>
        <Style Selector="Button.minimization_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#c80" />
        </Style>
        <Style Selector="Button.changebg_button">
            <Setter Property="Background" Value="#0af" />
        </Style>
        <Style Selector="Button.changebg_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#08f" />
        </Style>

        <Style Selector="TextBlock.close_button_text">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-2,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.minimization_button_text">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,-3,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="TextBlock.changebg_button_text">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Width" Value="20" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <Style Selector="StackPanel.main_layout">
            <Setter Property="Width" Value="880" />
            <Setter Property="Height" Value="520" />
        </Style>

        <Style Selector="ExperimentalAcrylicBorder.acrylic_main_layout_border">
            <Setter Property="Material">
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#000"
                    TintOpacity="0.5"
                    MaterialOpacity="0.3" />
            </Setter>

        </Style>
        <Style Selector="ExperimentalAcrylicBorder.acrylic_panel_border">
            <Setter Property="Material">
                <ExperimentalAcrylicMaterial
                    BackgroundSource="Digger"
                    TintColor="#000"
                    TintOpacity="0.5"
                    MaterialOpacity="0.3" />
            </Setter>
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.panel_border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Panel.panel_bg_cover">
            <!-- <Setter Property="Background" Value="#66000000"></Setter> -->
        </Style>

        <Style Selector="ExperimentalAcrylicBorder.instances_panel_border">
            <Setter Property="Margin" Value="15,15,5,20" />
            <Setter Property="Width" Value="80" />
        </Style>
        <Style Selector="ExperimentalAcrylicBorder.locations_panel_border">
            <Setter Property="Margin" Value="5,15,5,20" />
            <Setter Property="Width" Value="450" />
        </Style>
        <Style Selector="StackPanel.control_group">
            <Setter Property="Margin" Value="5,15,15,20" />
            <Setter Property="Width" Value="300" />
        </Style>
        <Style Selector="ExperimentalAcrylicBorder.instance_control_border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Height" Value="135" />
        </Style>
        <Style Selector="ExperimentalAcrylicBorder.location_control_border">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Width" Value="300" />
            <Setter Property="Height" Value="180" />
        </Style>
        <Style Selector="ExperimentalAcrylicBorder.setting_border">

            <Setter Property="Width" Value="300" />
            <Setter Property="Height" Value="150" />
        </Style>

        <Style Selector="RadioButton.port_button">
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="3,8,3,8" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="TextBlock.TextAlignment" Value="Center" />
        </Style>

        <Style Selector="RadioButton.port_button:unchecked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#ddd" />
            <Setter Property="Background" Value="#aa000000" />
            <Setter Property="Margin" Value="9,15,9,0" />
            <Style Selector="^:nth-last-child(1)">
                <Setter Property="Margin" Value="9,0,9,15" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="#eee" />
                <Setter Property="Background" Value="#cc000000" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="BorderBrush" Value="#fff" />
                <Setter Property="Background" Value="#dd000000" />
            </Style>
        </Style>


        <Style Selector="RadioButton.port_button:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="BorderBrush" Value="#08d" />
            <Setter Property="Background" Value="#cc224466" />
            <Setter Property="Margin" Value="9,15,9,0" />
            <Style Selector="^:nth-last-child(1)">
                <Setter Property="Margin" Value="9,0,9,15" />
            </Style>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="#09e" />
                <Setter Property="Background" Value="#dd224466" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="BorderBrush" Value="#0af" />
                <Setter Property="Background" Value="#ee224466" />
            </Style>
        </Style>

        <Style Selector="RadioButton.port_button_instance_off">
            <Setter Property="Foreground" Value="#fff" />
        </Style>
        <Style Selector="RadioButton.port_button_instance_on">
            <Setter Property="Foreground" Value="#8f0" />
        </Style>

        <Style Selector="Border.location_border">
            <Setter Property="Margin" Value="10,5,10,5" />
            <Setter Property="BorderBrush" Value="#035" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Background" Value="#B2000000" />
            <Setter Property="Width" Value="430" />
            <Setter Property="Height" Value="90" />
        </Style>
        <Style Selector="Border.location_border:nth-last-child(1)">
            <Setter Property="Margin" Value="10,5,10,10" />
        </Style>
        <Style Selector="Border.location_border:nth-child(1)">
            <Setter Property="Margin" Value="10,10,10,5" />
        </Style>


        <Style Selector="DockPanel.location_ops_dockpanel">
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="Height" Value="38" />
        </Style>
        <Style Selector="Button.location_name_button">
            <Setter Property="Margin" Value="15,13,15,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="25" />
            <Setter Property="MaxHeight" Value="25" />
            <Setter Property="MaxWidth" Value="300" />
        </Style>
        <Style Selector="Button.location_name_button /template/ ContentPresenter#PART_ContentPresenter">

            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#ddd" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.location_name_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#eee" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.location_name_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#fff" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Button.delete_location_button">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="19" />
            <Setter Property="MinHeight" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#d33" />
        </Style>
        <Style Selector="Button.delete_location_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#e33" />
        </Style>
        <Style Selector="Button.delete_location_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#f33" />
        </Style>

        <Style Selector="TextBox.path_textbox">
            <Setter Property="Background" Value="#5555" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="15,0,15,0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Width" Value="400" />
            <Setter Property="Height" Value="25" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.path_textbox:pointerover /template/ Border#PART_ContentPresenterBorder">
            <Setter Property="Background" Value="#5555" />
        </Style>

        <Style Selector="StackPanel.control_panel">
            <Setter Property="Width" Value="300" />
        </Style>

        <Style Selector="TextBlock.control_panel_title">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="FontStyle" Value="Italic" />
            <Setter Property="Margin" Value="10,5,0,3" />
        </Style>

        <Style Selector="TextBox.control_panel_textbox">
            <Setter Property="Background" Value="#82000000" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderBrush" Value="#777" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.control_panel_textbox:pointerover /template/ Border#PART_ContentPresenterBorder">
            <Setter Property="Background" Value="#98000000" />
            <Setter Property="BorderBrush" Value="#aaa" />
        </Style>
        <Style Selector="TextBox.control_panel_textbox:focus /template/ Border#PART_ContentPresenterBorder">
            <Setter Property="Background" Value="#af000000" />
            <Setter Property="BorderBrush" Value="#ddd" />
        </Style>

        <Style Selector="Button.instance_control_button">
            <Setter Property="Margin" Value="10,10,0,10" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Background" Value="#aa000000" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.instance_control_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#cc000000" />
        </Style>
        <Style Selector="Button.instance_control_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#dd000000" />
        </Style>
        <Style Selector="Button.instance_control_button:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#dd000000" />
            <Setter Property="Foreground" Value="#555" />
            <Setter Property="BorderBrush" Value="#555" />
        </Style>

        <Style Selector="Button.instance_start_button">
            <Setter Property="Padding" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#19d" />
            <Setter Property="BorderBrush" Value="#19d" />
        </Style>
        <Style Selector="Button.instance_start_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1be" />
            <Setter Property="BorderBrush" Value="#1be" />
        </Style>
        <Style Selector="Button.instance_start_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1cf" />
            <Setter Property="BorderBrush" Value="#1cf" />
        </Style>

        <Style Selector="Button.instance_start_button_running">
            <Setter Property="Padding" Value="0,2,0,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#8d0" />
            <Setter Property="BorderBrush" Value="#8d0" />
        </Style>
        <Style
            Selector="Button.instance_start_button_running:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#8e0" />
            <Setter Property="BorderBrush" Value="#8e0" />
        </Style>
        <Style
            Selector="Button.instance_start_button_running:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#8f0" />
            <Setter Property="BorderBrush" Value="#8f0" />
        </Style>

        <Style Selector="Button.instance_lock_button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#ddd" />
        </Style>
        <Style Selector="Button.instance_lock_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#eee" />
        </Style>
        <Style Selector="Button.instance_lock_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#fff" />
        </Style>

        <Style Selector="Button.instance_lock_button_locked">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#da0" />
            <Setter Property="BorderBrush" Value="#da0" />
        </Style>
        <Style
            Selector="Button.instance_lock_button_locked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#db0" />
            <Setter Property="BorderBrush" Value="#db0" />

        </Style>
        <Style Selector="Button.instance_lock_button_locked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fd0" />
            <Setter Property="BorderBrush" Value="#fd0" />
        </Style>

        <Style Selector="Button.add_instance_button">
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#ddd" />
        </Style>
        <Style Selector="Button.add_instance_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#eee" />
        </Style>
        <Style Selector="Button.add_instance_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#fff" />
        </Style>

        <Style Selector="Button.remove_instance_button">
            <Setter Property="Padding" Value="0,0,0,4" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="#d33" />
            <Setter Property="BorderBrush" Value="#d33" />
        </Style>
        <Style Selector="Button.remove_instance_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#e33" />
            <Setter Property="BorderBrush" Value="#e33" />
        </Style>
        <Style Selector="Button.remove_instance_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#f33" />
            <Setter Property="BorderBrush" Value="#f33" />
        </Style>

        <Style Selector="TextBox.password_textbox">
            <Setter Property="Margin" Value="10,5,10,10" />
        </Style>

        <Style Selector="FlyoutPresenter.add_instance_flyout">
            <Setter Property="Height" Value="70" />
            <Setter Property="MinHeight" Value="70" />
            <Setter Property="Background" Value="#222" />
            <Setter Property="FontFamily" Value="Cascadia Code Light, LXGW WenKai" />
        </Style>
        <Style Selector="TextBox.add_instance_textbox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="80" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="10,0,10,0" />
            <Setter Property="Foreground" Value="#fff" />
        </Style>
        <Style Selector="Button.add_instance_confirm_button">
            <Setter Property="Foreground" Value="#19d" />
            <Setter Property="BorderBrush" Value="#19d" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style
            Selector="Button.add_instance_confirm_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1be" />
            <Setter Property="BorderBrush" Value="#1be" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style
            Selector="Button.add_instance_confirm_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1cf" />
            <Setter Property="BorderBrush" Value="#1cf" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="FlyoutPresenter.remove_instance_flyout">
            <Setter Property="Height" Value="70" />
            <Setter Property="MinHeight" Value="70" />
            <Setter Property="Background" Value="#222" />
            <Setter Property="FontFamily" Value="Cascadia Code Light, LXGW WenKai" />
        </Style>
        <Style Selector="Button.remove_instance_confirm_button">
            <Setter Property="Foreground" Value="#c33" />
            <Setter Property="BorderBrush" Value="#c33" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Margin" Value="0,0,10,0" />
