        <Style Selector="Button.select_path_button">
            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#ddd" />
        </Style>
        <Style Selector="Button.select_path_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#eee" />
        </Style>
        <Style Selector="Button.select_path_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#fff" />
        </Style>

        <Style Selector="Button.add_location_button">
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#19d" />
            <Setter Property="BorderBrush" Value="#19d" />
        </Style>
        <Style Selector="Button.add_location_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1be" />
            <Setter Property="BorderBrush" Value="#1be" />
        </Style>
        <Style Selector="Button.add_location_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1cf" />
            <Setter Property="BorderBrush" Value="#1cf" />
        </Style>

        <Style Selector="Border.setting_slider_border">
            <Setter Property="Margin" Value="9,5,9,0" />
            <Setter Property="Background" Value="#82000000" />
            <Setter Property="BorderBrush" Value="#666" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style Selector="StackPanel.setting_slider_stackpanel">
            <Setter Property="Width" Value="280" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.setting_slider_textblock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Height" Value="26" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="60" />
        </Style>
        <Style Selector="Slider.setting_slider">
            <Setter Property="Width" Value="200" />
            <Setter Property="Margin" Value="0,8,5,0" />
            <Setter Property="Height" Value="36" />
        </Style>

        <Style Selector="Button.open_appdata_button">
            <Setter Property="Margin" Value="9,5,9,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#777" />
            <Setter Property="Background" Value="#82000000" />
        </Style>
        <Style Selector="Button.open_appdata_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="Background" Value="#98000000" />
        </Style>
        <Style Selector="Button.open_appdata_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#ddd" />
            <Setter Property="Background" Value="#af000000" />
        </Style>

        <Style Selector="FlyoutPresenter.whitelist_flyout">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="#222" />
            <Setter Property="FontFamily" Value="Cascadia Code Light, LXGW WenKai" />
        </Style>
        <Style Selector="TextBox.whitelist_textbox">
            <Setter Property="Height" Value="120" />
            <Setter Property="Width" Value="420" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Margin" Value="10,10,0,10" />
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>

        <Style Selector="Button.whitelist_button">
            <Setter Property="Margin" Value="0,5,9,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#777" />
            <Setter Property="Background" Value="#82000000" />
        </Style>
        <Style Selector="Button.whitelist_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="Background" Value="#98000000" />
        </Style>
        <Style Selector="Button.whitelist_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#ddd" />
            <Setter Property="Background" Value="#af000000" />
        </Style>

        <Style Selector="Button.autostart_button">
            <Setter Property="Margin" Value="0,5,9,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#777" />
            <Setter Property="Background" Value="#82000000" />
        </Style>
        <Style Selector="Button.autostart_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="Background" Value="#98000000" />
        </Style>
        <Style Selector="Button.autostart_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#ddd" />
            <Setter Property="Background" Value="#af000000" />
        </Style>
        <Style Selector="Button.autostart_button.autostart_button_enabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#19d" />
            <Setter Property="BorderBrush" Value="#19d" />
        </Style>
        <Style Selector="Button.autostart_button.autostart_button_enabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1be" />
            <Setter Property="BorderBrush" Value="#1be" />
        </Style>
        <Style Selector="Button.autostart_button.autostart_button_enabled:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1cf" />
            <Setter Property="BorderBrush" Value="#1cf" />
        </Style>

        <Style Selector="Button.tray_button">
            <Setter Property="Margin" Value="0,5,9,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Width" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="#ddd" />
            <Setter Property="BorderBrush" Value="#777" />
            <Setter Property="Background" Value="#82000000" />
        </Style>
        <Style Selector="Button.tray_button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#eee" />
            <Setter Property="BorderBrush" Value="#aaa" />
            <Setter Property="Background" Value="#98000000" />
        </Style>
        <Style Selector="Button.tray_button:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#fff" />
            <Setter Property="BorderBrush" Value="#ddd" />
            <Setter Property="Background" Value="#af000000" />
        </Style>
        <Style Selector="Button.tray_button.tray_button_enabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#19d" />
            <Setter Property="BorderBrush" Value="#19d" />
        </Style>
        <Style Selector="Button.tray_button.tray_button_enabled:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1be" />
            <Setter Property="BorderBrush" Value="#1be" />
        </Style>
        <Style Selector="Button.tray_button.tray_button_enabled:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Foreground" Value="#1cf" />
            <Setter Property="BorderBrush" Value="#1cf" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="Background" Value="#cc000000" />
            <Setter Property="Foreground" Value="#ccc" />
            <Setter Property="BorderBrush" Value="#555" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Padding" Value="6,4" />
        </Style>

    </Window.Styles>

    <StackPanel Orientation="Vertical" Classes="window_basics">
        <ExperimentalAcrylicBorder Classes="acrylic_title_border">
            <Border Name="TitleBar" Classes="title_bar">
                <DockPanel Classes="title_bar_dockpanel" LastChildFill="False">
                    <Button DockPanel.Dock="Right" Classes="close_button title_button"
                            Command="{Binding CloseWindowCommand}">
                        <TextBlock Classes="close_button_text">×</TextBlock>
                    </Button>
                    <Button DockPanel.Dock="Right" Classes="minimization_button title_button"
                            Command="{Binding MinimizeWindowCommand}">
                        <TextBlock Classes="minimization_button_text">-</TextBlock>
                    </Button>
                    <Button DockPanel.Dock="Right" Classes="changebg_button title_button"
                            Command="{Binding ChangeBackgroundCommand}">
                        <TextBlock Classes="changebg_button_text">∞</TextBlock>
                    </Button>
                </DockPanel>
            </Border>
        </ExperimentalAcrylicBorder>
        <ExperimentalAcrylicBorder Classes="acrylic_main_layout_border">
            <StackPanel Orientation="Horizontal" Classes="main_layout" Name="MainLayout">
                <ExperimentalAcrylicBorder Classes="acrylic_panel_border instances_panel_border">
                    <Border Classes="panel_border" Name="InstancesPanel">
                        <Panel Classes="panel_bg_cover"
                               Background="{Binding UIData.PanelOpacity, Converter={StaticResource BackgroundOpacityConverter}}">
                            <ScrollViewer>
                                <StackPanel>
                                    <ItemsRepeater ItemsSource="{Binding Instances}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton Theme="{DynamicResource PureCardRadioButton}"
                                                             Classes.port_button_instance_off="{Binding IsRunning}"
                                                             Classes.port_button_instance_on="{Binding IsRunning}"
                                                             Classes="port_button"
                                                             Content="{Binding Port}" GroupName="PortRadioBtn">
                                                    <RadioButton.IsChecked>
                                                        <MultiBinding
                                                            Converter="{StaticResource PortButtonCheckedConverter}">
                                                            <Binding Path="Port" />
                                                            <Binding
                                                                Path="#Root.((vm:MainWindowViewModel)DataContext).CurrentInstance.Port" />
                                                        </MultiBinding>
                                                    </RadioButton.IsChecked>
                                                    <Interaction.Behaviors>
                                                        <EventTriggerBehavior EventName="Click">
                                                            <InvokeCommandAction
                                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).ChangeCurrentInstanceCommand}"
                                                                CommandParameter="{Binding Port}" />
                                                        </EventTriggerBehavior>
                                                    </Interaction.Behaviors>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </ExperimentalAcrylicBorder>
                <ExperimentalAcrylicBorder Classes="acrylic_panel_border locations_panel_border">
                    <Border Classes="panel_border" Name="LocationsPanel">
                        <Panel Classes="panel_bg_cover"
                               Background="{Binding UIData.PanelOpacity, Converter={StaticResource BackgroundOpacityConverter}}">
                            <ScrollViewer>
                                <ItemsRepeater>
                                    <ItemsRepeater.ItemsSource>
                                        <MultiBinding
                                            Converter="{StaticResource CurrentLocationsConverter}">
                                            <Binding Path="Instances" />
                                            <Binding
                                                Path="#Root.((vm:MainWindowViewModel)DataContext).CurrentInstance.Port" />
                                        </MultiBinding>
                                    </ItemsRepeater.ItemsSource>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="service:Location">
                                            <Border Classes="location_border">
                                                <StackPanel Orientation="Vertical">
                                                    <DockPanel Classes="location_ops_dockpanel" LastChildFill="False">
                                                        <Button DockPanel.Dock="Left" Content="{Binding Name}"
                                                                Classes="location_name_button"
                                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).OpenDirectoryCommand}"
                                                                CommandParameter="{Binding Path}" />
                                                        <Button DockPanel.Dock="Right" VerticalAlignment="Top"
                                                                Classes="delete_location_button" Content="×"
                                                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).RemoveLocationCommand}"
                                                                CommandParameter="{Binding .}" />
                                                    </DockPanel>

                                                    <TextBox Text="{Binding Path}" Classes="path_textbox"
                                                             Focusable="False" IsReadOnly="True" />

                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Panel>
                    </Border>
                </ExperimentalAcrylicBorder>
                <StackPanel Orientation="Vertical" Classes="control_group">
                    <ExperimentalAcrylicBorder Classes="acrylic_panel_border instance_control_border">
                        <Border Classes="panel_border" Name="InstanceControlPanel">
                            <Panel Classes="panel_bg_cover"
                                   Background="{Binding UIData.PanelOpacity, Converter={StaticResource BackgroundOpacityConverter}}">
                                <StackPanel Classes="control_panel">
                                    <TextBlock Text="Instance Control" Classes="control_panel_title" />
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            IsEnabled="{Binding CurrentInstance, Converter={StaticResource IsNotNullConverter}}"
                                            Content="⏻" Classes="instance_control_button instance_start_button"
                                            Classes.instance_start_button_running="{Binding CurrentInstance.IsRunning}"
                                            Command="{Binding StartOrStopInstanceCommand}" />
                                        <Button
                                            IsEnabled="{Binding CurrentInstance, Converter={StaticResource IsNotNullConverter}}"
                                            Content="{Binding CurrentInstance.IsLocked, Converter={StaticResource InstanceLockedConverter}, Mode=TwoWay}"
                                            Classes="instance_control_button instance_lock_button"
                                            Classes.instance_lock_button_locked="{Binding CurrentInstance.IsLocked}"
                                            Command="{Binding ChangeLockedCommand}" />
                                        <Button Content="+" Classes="instance_control_button add_instance_button"
                                                Name="AddInstanceButton">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom" FlyoutPresenterClasses="add_instance_flyout">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBox Text="{Binding NewInstancePortText}"
                                                                 Watermark="Port"
                                                                 Classes="add_instance_textbox control_panel_textbox" />
                                                        <Button Content="✓" Classes="add_instance_confirm_button"
                                                                Command="{Binding AddInstanceCommand}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                        <Button
                                            IsEnabled="{Binding CurrentInstance, Converter={StaticResource IsNotNullConverter}}"
                                            Content="×︎" Classes="instance_control_button remove_instance_button"
                                            x:Name="RemoveInstanceButton">
                                            <Button.Flyout>
                                                <Flyout Placement="Bottom"
                                                        FlyoutPresenterClasses="remove_instance_flyout">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Sure to remove this instance?"
                                                                   VerticalAlignment="Center" Margin="10,0,10,0" />
                                                        <Button Content="✓"
                                                                Classes="remove_instance_confirm_button"
                                                                Command="{Binding RemoveCurrentInstanceCommand}"
                                                                CommandParameter="{Binding #RemoveInstanceButton}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                    <TextBox
                                        IsEnabled="{Binding CurrentInstance, Converter={StaticResource IsNotNullConverter}}"
                                        IsReadOnly="{Binding CurrentInstance.IsLocked}"
                                        Classes="password_textbox control_panel_textbox"
                                        Text="{Binding CurrentInstance.Password}"
                                        Watermark="Password">
                                        <Interaction.Behaviors>
                                            <EventTriggerBehavior EventName="LostFocus">
                                                <InvokeCommandAction Command="{Binding SaveAppDataCommand}" />
                                            </EventTriggerBehavior>
                                        </Interaction.Behaviors>
                                    </TextBox>
                                </StackPanel>
                            </Panel>
                        </Border>
                    </ExperimentalAcrylicBorder>
                    <ExperimentalAcrylicBorder Classes="acrylic_panel_border location_control_border">
                        <Border Classes="panel_border" Name="LocationControlPanel">
                            <Panel Classes="panel_bg_cover"
                                   Background="{Binding UIData.PanelOpacity, Converter={StaticResource BackgroundOpacityConverter}}">
                                <StackPanel Classes="control_panel">
                                    <TextBlock Text="Location Control" Classes="control_panel_title" />
                                    <TextBox Classes="location_name_textbox control_panel_textbox"
                                             Text="{Binding NewLocationName}"
                                             Watermark="Location Name" />
                                    <StackPanel Orientation="Horizontal" Classes="location_control_stackpanel1">
                                        <TextBox Classes="location_path_textbox control_panel_textbox"
                                                 Watermark="Location Path"
                                                 Text="{Binding NewLocationPath}" />
                                        <StackPanel Orientation="Vertical" Classes="location_control_stackpanel2">
                                            <Button
                                                IsEnabled="{Binding CurrentInstance, Converter={StaticResource IsNotNullConverter}}"
                                                Content="📁" Classes="location_control_button select_path_button"
                                                Command="{Binding SelectLocationCommand}" />
                                            <Button
                                                IsEnabled="{Binding CurrentInstance, Converter={StaticResource IsNotNullConverter}}"
                                                Content="✓" Classes="location_control_button add_location_button"
                                                Command="{Binding AddLocationCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Panel>
                        </Border>
                    </ExperimentalAcrylicBorder>
                    <ExperimentalAcrylicBorder Classes="acrylic_panel_border setting_border">
                        <Border Classes="panel_border" Name="SettingPanel">
                            <Panel Classes="panel_bg_cover"
                                   Background="{Binding UIData.PanelOpacity, Converter={StaticResource BackgroundOpacityConverter}}">
                                <StackPanel Classes="control_panel">
                                    <TextBlock Text="Setting" Classes="control_panel_title" />
                                    <Border Classes="setting_slider_border">
                                        <StackPanel Orientation="Horizontal" Classes="setting_slider_stackpanel">
                                            <TextBlock Text="Panel Opcatity" Classes="setting_slider_textblock" />
                                            <Slider Value="{Binding UIData.PanelOpacity}" Classes="setting_slider">
                                                <Interaction.Behaviors>
                                                    <EventTriggerBehavior EventName="PointerCaptureLost">
                                                        <InvokeCommandAction Command="{Binding SaveAppDataCommand}" />
                                                    </EventTriggerBehavior>
                                                </Interaction.Behaviors>
                                            </Slider>
                                        </StackPanel>
                                    </Border>
                                    <Border Classes="setting_slider_border">
                                        <StackPanel Orientation="Horizontal" Classes="setting_slider_stackpanel">
                                            <TextBlock Text="Panel       Blur" Classes="setting_slider_textblock" />
                                            <Slider
                                                x:Name="BlurSlider"
                                                Value="{Binding UIData.PanelBlur, Converter={StaticResource BackgroundBlurConverter}}"
                                                Classes="setting_slider">
                                                <Interaction.Behaviors>
                                                    <EventTriggerBehavior EventName="PointerCaptureLost">
                                                        <InvokeCommandAction Command="{Binding SaveAppDataCommand}" />
                                                    </EventTriggerBehavior>
                                                    <EventTriggerBehavior EventName="ValueChanged">
                                                        <InvokeCommandAction Command="{Binding ChangePanelBlurCommand}" />
                                                    </EventTriggerBehavior>
                                                </Interaction.Behaviors>
                                            </Slider>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="🔧"
                                                Classes="open_appdata_button"
                                                ToolTip.Tip="Open config file"
                                                ToolTip.ShowDelay="100"
                                                Command="{Binding OpenAppDataFileCommand}" />
                                        <Button Content="✅"
                                                Classes="whitelist_button"
                                                ToolTip.Tip="Edit Whitelist"
                                                ToolTip.ShowDelay="100"
                                                x:Name="WhiteListButton"
                                                IsEnabled="{Binding CurrentInstance, Converter={StaticResource IsNotNullConverter}}">
                                            <Button.Flyout>
                                                <Flyout Placement="Top" FlyoutPresenterClasses="whitelist_flyout">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                                        <TextBox Text="{Binding WhiteListText}"
                                                                 Watermark="One IP per line"
                                                                 Classes="whitelist_textbox control_panel_textbox"
                                                                 VerticalAlignment="Bottom" />
                                                        <Button Content="✓"
                                                                Classes="add_instance_confirm_button"
                                                                Margin="10,0,10,10"
                                                                VerticalAlignment="Bottom"
                                                                Command="{Binding SaveWhiteListCommand}"
                                                                CommandParameter="{Binding #WhiteListButton}" />
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <Interaction.Behaviors>
                                                <EventTriggerBehavior EventName="Click">
                                                    <InvokeCommandAction Command="{Binding InitWhiteListTextCommand}" />
                                                </EventTriggerBehavior>
                                            </Interaction.Behaviors>
                                        </Button>
                                        <Button Content="🚀"
                                                Classes="autostart_button"
                                                Classes.autostart_button_enabled="{Binding UIData.IsAutoStart}"
                                                ToolTip.Tip="Toggle Launch at Startup"
                                                ToolTip.ShowDelay="100"
                                                Command="{Binding ToggleAutoStartCommand}" />
                                        <Button Content="📥"
                                                Classes="tray_button"
                                                Classes.tray_button_enabled="{Binding UIData.MinimizeToTray}"
                                                ToolTip.Tip="Minimize to tray on close"
                                                ToolTip.ShowDelay="100"
                                                Command="{Binding ToggleMinimizeToTrayCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Panel>
                        </Border>
                    </ExperimentalAcrylicBorder>
                </StackPanel>
            </StackPanel>
        </ExperimentalAcrylicBorder>
    </StackPanel>

</Window>